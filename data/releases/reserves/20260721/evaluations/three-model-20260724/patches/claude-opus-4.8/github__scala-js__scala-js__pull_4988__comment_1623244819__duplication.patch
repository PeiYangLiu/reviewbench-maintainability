 object FunctionBuilder {
+  /** Type class witnessing that a value of type `A` can be used as a block type.
+   *
+   *  This unifies the various block-type shorthands (`BlockType`, a single result
+   *  `Type`, a `List[Type]` of results, or a full `FunctionType`) accepted by the
+   *  structured control-flow helpers, avoiding one overload per shorthand.
+   */
+  sealed abstract class BlockTypeLike[-A] {
+    def toBlockType(fb: FunctionBuilder, blockType: A): BlockType
+  }
+
+  object BlockTypeLike {
+    def apply[A](implicit bt: BlockTypeLike[A]): BlockTypeLike[A] = bt
+
+    implicit object BlockTypeIsBlockType extends BlockTypeLike[BlockType] {
+      def toBlockType(fb: FunctionBuilder, blockType: BlockType): BlockType =
+        blockType
+    }
+
+    implicit object ResultTypeIsBlockType extends BlockTypeLike[Type] {
+      def toBlockType(fb: FunctionBuilder, resultType: Type): BlockType =
+        BlockType.ValueType(resultType)
+    }
+
+    implicit object ResultTypesIsBlockType extends BlockTypeLike[List[Type]] {
+      def toBlockType(fb: FunctionBuilder, resultTypes: List[Type]): BlockType =
+        fb.sigToBlockType(FunctionType(Nil, resultTypes))
+    }
+
+    implicit object FunctionTypeIsBlockType extends BlockTypeLike[FunctionType] {
+      def toBlockType(fb: FunctionBuilder, sig: FunctionType): BlockType =
+        fb.sigToBlockType(sig)
+    }
+  }
+
