+func (ed *EncryptedData) verifyAuthMessage(encryptedMessage, ephemeralPubKeyBytes, originatorPubKeyBytes, macBytes []byte) error {
+	message := append(encryptedMessage, ephemeralPubKeyBytes...)
+	authMessage := sha256.New()
+	_, err := authMessage.Write(message)
+	if err != nil {
+		return err
+	}
+
+	suite := ed25519.NewEd25519()
+	keygen := crypto.NewKeyGenerator(suite)
+	originatorPubKey, err := keygen.PublicKeyFromByteArray(originatorPubKeyBytes)
+	if err != nil {
+		return err
+	}
+
+	signer := singlesig.Ed25519Signer{}
+	return signer.Verify(originatorPubKey, authMessage.Sum(nil), macBytes)
 }
 
