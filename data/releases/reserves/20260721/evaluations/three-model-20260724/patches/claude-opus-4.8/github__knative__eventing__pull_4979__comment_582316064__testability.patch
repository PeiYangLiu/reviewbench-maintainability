+// enqueueBrokerTriggers returns an event handler function that, given a Broker
+// object, enqueues all the Triggers belonging to it using the provided enqueue
+// function. It is extracted into its own function to make it unit testable.
+func enqueueBrokerTriggers(logger *zap.SugaredLogger, triggerLister v1.TriggerLister, enqueue func(obj interface{})) func(obj interface{}) {
+	return func(obj interface{}) {
+		for _, t := range getBrokerTriggers(logger, triggerLister, obj) {
+			enqueue(t)
+		}
+	}
 }
 
