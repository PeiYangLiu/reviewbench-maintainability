+
+// SyncFlushOnStop returns an Option which configures the telemetry client to
+// synchronously flush all outstanding telemetry messages when Stop is called,
+// rather than flushing them in the background. This is useful for short-lived
+// processes that may exit before a background flush has a chance to complete.
+func SyncFlushOnStop() Option {
+	return func(c *client) {
+		c.syncFlushOnStop = true
+	}
 }
 
