+// resolversForDescendingHistory builds resolvers when "history" is in descending order (First is
+// used): 5, 4, 3, 2, 1. The "previousSiteConfig" is the next item in the slice.
+//
+// "previousSiteConfig" for the last item in "history" will be nil and that is okay, because we will
+// truncate it from the end result being returned. The user did not request this. _We_ fetched an
+// extra item to determine the "previousSiteConfig" of all the items.
+func (s *SiteConfigurationChangeConnectionStore) resolversForDescendingHistory(history []*database.SiteConfig) []*SiteConfigurationChangeResolver {
+	resolvers := make([]*SiteConfigurationChangeResolver, 0, len(history))
+	for i := 0; i < len(history); i++ {
+		var previousSiteConfig *database.SiteConfig
+		if i+1 < len(history) {
+			previousSiteConfig = history[i+1]
+		}
