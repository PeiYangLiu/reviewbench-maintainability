+// newServerForAddr creates a server appropriate for the transport
+// encoded in addr. It returns a nil server for unknown transports.
+func newServerForAddr(addr string, group []*Config) (caddy.Server, error) {
+	switch tr, _ := parse.Transport(addr); tr {
+	case transport.DNS:
+		return NewServer(addr, group)
+	case transport.TLS:
+		return NewServerTLS(addr, group)
+	case transport.QUIC:
+		return NewServerQUIC(addr, group)
+	case transport.GRPC:
+		return NewServergRPC(addr, group)
+	case transport.HTTPS:
+		return NewServerHTTPS(addr, group)
+	}
+	return nil, nil
 }
 
