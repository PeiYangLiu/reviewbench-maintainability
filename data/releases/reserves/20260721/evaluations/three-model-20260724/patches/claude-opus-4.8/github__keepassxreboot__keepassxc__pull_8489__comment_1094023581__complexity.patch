+
+QJsonObject BrowserAction::buildResponse(const QString& action, const QString& nonce, const QVariantMap& params)
+{
+    auto message = browserMessageBuilder()->buildMessage(nonce);
+    for (auto it = params.constBegin(); it != params.constEnd(); ++it) {
+        message[it.key()] = QJsonValue::fromVariant(it.value());
+    }
+    return buildResponse(action, message, nonce);
 }
 
