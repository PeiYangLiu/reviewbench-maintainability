+// isSameDay reports whether the given log file was last modified on the current day.
+func isSameDay(logFile *os.File) bool {
+	fileInfo, err := logFile.Stat()
+	if err != nil {
+		return false
+	}
+	now := time.Now().Format(FileDateFormat)
+	last := fileInfo.ModTime().Format(FileDateFormat)
+	return now == last
 }
 
