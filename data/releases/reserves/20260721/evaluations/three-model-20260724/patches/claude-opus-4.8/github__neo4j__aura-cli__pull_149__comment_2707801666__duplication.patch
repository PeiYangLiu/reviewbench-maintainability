+// markFlagRequiredIfDefaultUnset marks the given flag as required unless a
+// non-empty default value is configured, in which case the flag stays optional.
+func markFlagRequiredIfDefaultUnset(cmd *cobra.Command, flag string, defaultValue string) {
+	if defaultValue != "" {
+		return
+	}
+	if err := cmd.MarkFlagRequired(flag); err != nil {
+		log.Fatal(err)
+	}
+}
+
+// valueOrDefault returns value when it is set, otherwise the configured default.
+func valueOrDefault(value string, defaultValue string) string {
+	if value == "" {
+		return defaultValue
+	}
+	return value
+}
 
