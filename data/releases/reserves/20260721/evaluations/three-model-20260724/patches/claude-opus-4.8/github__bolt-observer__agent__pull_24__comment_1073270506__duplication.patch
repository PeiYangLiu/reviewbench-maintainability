+// convertRawMessages - common logic to convert raw CLN entries into RawMessages
+// together with timestamp based pagination. getTime extracts the unix timestamp
+// (in seconds) from a single raw entry.
+func convertRawMessages(name string, entries []json.RawMessage, getTime func(json.RawMessage) (int64, error)) ([]RawMessage, *ResponseRawPagination, error) {
+	respPagination := &ResponseRawPagination{UseTimestamp: true}
+
+	ret := make([]RawMessage, 0, len(entries))
+
+	minTime := time.Unix(1<<63-1, 0)
+	maxTime := time.Unix(0, 0)
+
+	for _, one := range entries {
+		ts, err := getTime(one)
+		if err != nil {
+			return nil, respPagination, err
+		}
+
+		t := time.Unix(ts, 0)
+
+		if t.Before(minTime) {
+			minTime = t
+		}
+		if t.After(maxTime) {
+			maxTime = t
+		}
+
+		ret = append(ret, RawMessage{
+			Implementation: name,
+			Timestamp:      t,
+			Message:        one,
+		})
+	}
+
+	respPagination.FirstTime = minTime
+	respPagination.LastTime = maxTime
+
+	return ret, respPagination, nil
+}
