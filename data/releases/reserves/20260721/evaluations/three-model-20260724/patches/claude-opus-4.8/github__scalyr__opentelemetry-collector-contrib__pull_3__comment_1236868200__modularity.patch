+// fallbackEventTimestamp returns a timestamp to use when a log record doesn't
+// contain an explicit timestamp. It falls back to the observed timestamp and,
+// if that is also missing, to the current time.
+func fallbackEventTimestamp(observedTs time.Time) string {
+	// ObservedTimestamp should always be set, but in case if it's not, we fall back to
+	// current time
+	// TODO: We should probably also do a rate limited log message here since this
+	// could indicate an issue with the current setup in case most events don't contain
+	// a timestamp.
+	if !observedTs.Equal(time.Unix(0, 0)) {
+		return strconv.FormatInt(observedTs.UnixNano(), 10)
+	}
+	return strconv.FormatInt(now().UnixNano(), 10)
+}
