+// Shared implementation of skip_* for fixed-width PLAIN types.  ELEM_SIZE is
+// the byte width of one element, DUMMY_TYPE / READ_FN are used for the
+// per-value fallback when the ByteStream is not wrapped (paged).
+#define PLAIN_SKIP_FIXED(ELEM_SIZE, DUMMY_TYPE, READ_FN)                    \
+    do {                                                                    \
+        skipped = 0;                                                        \
+        if (!in.is_wrapped()) {                                            \
+            DUMMY_TYPE dummy;                                              \
+            while (skipped < count && in.has_remaining()) {               \
+                int ret = common::SerializationUtil::READ_FN(dummy, in);  \
+                if (ret != common::E_OK) return ret;                      \
+                ++skipped;                                                 \
+            }                                                              \
+            return common::E_OK;                                          \
+        }                                                                  \
+        skipped = static_cast<int>(std::min<uint32_t>(                    \
+            in.remaining_size() / (ELEM_SIZE),                            \
+            static_cast<uint32_t>(count)));                               \
+        if (skipped <= 0) {                                              \
+            skipped = 0;                                                  \
+            return common::E_OK;                                          \
+        }                                                                  \
+        in.wrapped_buf_advance_read_pos(                                  \
+            static_cast<uint32_t>(skipped) * (ELEM_SIZE));               \
+        return common::E_OK;                                             \
+    } while (0)
+
