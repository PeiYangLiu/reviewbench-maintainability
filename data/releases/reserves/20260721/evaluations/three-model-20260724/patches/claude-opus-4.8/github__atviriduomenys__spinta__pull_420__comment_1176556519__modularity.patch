+def _parse_foreign_key_violation(error_message: str) -> tuple:
+    """Extract referencing property name and referenced id from a
+    ForeignKeyViolation error message detail.
+
+    Example message:
+        Key (country._id)=(abc123) is not present in table "country".
+    Returns ('country', 'abc123').
+    """
+    error_property_name = re.search(r'Key \((.*?)\)', error_message).group(1).split(".")[0]
+    error_ref_id = re.search(r'\)=\((.*?)\)', error_message).group(1)
+    return error_property_name, error_ref_id
+
+
+def _parse_referring_model(error_message: str) -> str:
+    """Extract the referring model (table) name from a ForeignKeyViolation
+    error message detail.
+
+    Example message:
+        Key (_id)=(abc123) is still referenced from table "city".
+    Returns 'city'.
+    """
+    return re.search(r'\"([^"]*)\"', error_message).group(1)
 
 
