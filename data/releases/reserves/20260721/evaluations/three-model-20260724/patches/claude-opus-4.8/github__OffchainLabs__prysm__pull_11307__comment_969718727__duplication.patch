+// proposerSettingsWithBeaconDefault builds a new ProposerSettings for the given validator key and
+// proposer option, using the fee recipient default reported by the beacon node when available,
+// otherwise falling back to the provided default proposer option.
+func (s *Server) proposerSettingsWithBeaconDefault(
+	ctx context.Context,
+	validatorKey []byte,
+	pOption *validatorServiceConfig.ProposerOption,
+	defaultOption *validatorServiceConfig.ProposerOption,
+) *validatorServiceConfig.ProposerSettings {
+	settings := &validatorServiceConfig.ProposerSettings{
+		ProposeConfig: map[[fieldparams.BLSPubkeyLength]byte]*validatorServiceConfig.ProposerOption{
+			bytesutil.ToBytes48(validatorKey): pOption,
+		},
+		DefaultConfig: defaultOption,
+	}
+	// get the default fee recipient defined with an invalid public key from beacon node
+	resp, err := s.beaconNodeValidatorClient.GetFeeRecipientByPubKey(ctx, &eth.FeeRecipientByPubKeyRequest{
+		PublicKey: []byte("0x0"),
+	})
+	if resp != nil && len(resp.FeeRecipient) != 0 && err == nil {
+		settings.DefaultConfig = &validatorServiceConfig.ProposerOption{
+			FeeRecipient: common.BytesToAddress(resp.FeeRecipient),
+		}
+	}
+	return settings
+}
