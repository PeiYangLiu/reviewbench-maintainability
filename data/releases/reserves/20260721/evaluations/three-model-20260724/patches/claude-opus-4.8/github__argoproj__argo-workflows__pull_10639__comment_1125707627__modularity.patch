+// getNodeAndDescendants returns the given node along with all of its
+// descendant nodes, discovered via a breadth-first traversal of Children.
+func (woc *wfOperationCtx) getNodeAndDescendants(node wfv1.NodeStatus) []wfv1.NodeStatus {
+	nodes := []wfv1.NodeStatus{}
+	queue := []wfv1.NodeStatus{node}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, childID := range current.Children {
+			queue = append(queue, woc.wf.Status.Nodes[childID])
+		}
+		nodes = append(nodes, current)
+	}
+	return nodes
 }
 
