+def _add_scale_option(options, min_stretch, max_stretch, src_nodata=None):
+    """
+    Adds the ``-scale`` option (and, if needed, the ``-a_nodata`` option) to the
+    given GDAL utility options dictionary.
+
+    Parameters
+    ----------
+    options : dict
+        Dictionary storing the GDAL utility options. It is modified in place.
+    min_stretch : number or None
+        Minimum input pixel value to consider for scaling pixels to 0-255.
+    max_stretch : number or None
+        Maximum input pixel value to consider for scaling pixels to 0-255.
+    src_nodata : int, optional
+        No data value of the input image. Defaults to None.
+
+    """
+    options["-scale"] = ' '
+    if (min_stretch is not None) and (max_stretch is not None):
+        options['-scale'] = (min_stretch, max_stretch, 0, 255)
+        # stretching should be done differently if nodata value exist.
+        # depending on nodatavalue, first or last position is reserved for nodata value
+        if src_nodata is not None:
+            if src_nodata < min_stretch:
+                options['-scale'] = (min_stretch, max_stretch, 1, 255)
+                options['-a_nodata'] = 0
+            elif src_nodata > max_stretch:
+                options['-scale'] = (min_stretch, max_stretch, 0, 254)
+                options['-a_nodata'] = 255
 
 
