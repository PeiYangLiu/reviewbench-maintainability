+def process_injected_data(event, request_time_epoch_ms, args, tags, event_subtype):
+    """Insert an upstream authorizer span when injected authorizer data is present.
+
+    Returns a tuple of (upstream_authorizer_span, finish_time_ns), both of which
+    may be None if no authorizer span was inserted.
+    """
+    injected_authorizer_data = get_injected_authorizer_data(
+        event, _EventSource(EventTypes.API_GATEWAY, event_subtype)
+    )
+    if not injected_authorizer_data:
+        return None, None
+    try:
+        request_context = event.get("requestContext")
+        start_time_ns = int(
+            injected_authorizer_data.get(Headers.Parent_Span_Finish_Time)
+        )
+        finish_time_ns = (
+            request_time_epoch_ms
+            + (
+                int(
+                    request_context.get("authorizer", {}).get("integrationLatency", 0)
+                )
+            )
+        ) * 1e6
+        upstream_authorizer_span = insert_upstream_authorizer_span(
+            args, tags, start_time_ns, finish_time_ns
+        )
+        return upstream_authorizer_span, finish_time_ns
+    except Exception as e:
+        traceback.print_exc()
+        logger.debug(
+            "Unable to insert authorizer span. Continue to generate the main span.\
+             Event %s, Reason: %s",
+            event,
+            e,
+        )
+        return None, None
+
