+// getAPIID returns the apiID path variable for the given request. It is
+// deliberately small and reusable so that route handlers don't have to know
+// about the underlying router internals.
+func getAPIID(r *http.Request) string {
+	return mux.Vars(r)["apiID"]
+}
+
+// isPublicScope reports whether the caller requested the public (Tyk-extension
+// stripped) representation of an OAS API definition.
+func isPublicScope(r *http.Request) bool {
+	return r.URL.Query().Get("mode") == "public"
+}
