 from loguru import logger as log
 from modelforge.potential.models import PairlistData
 from modelforge.dataset.dataset import NNPInputTuple
+
+
+def _build_pairlist_data(
+    in_cutoff: torch.Tensor,
+    i_pairs: torch.Tensor,
+    j_pairs: torch.Tensor,
+    r_ij: torch.Tensor,
+    d_ij: torch.Tensor,
+    only_unique_pairs: bool,
+    positions: torch.Tensor,
+) -> PairlistData:
+    """
+    Assemble a PairlistData object from the unique pairs within the cutoff.
+
+    When ``only_unique_pairs`` is True the unique (i < j) pairs are returned
+    directly. Otherwise each unique pair is duplicated to also include the
+    reversed (j, i) pair, copying the distances and negating the displacement
+    vectors, which is faster than recomputing them.
+
+    Parameters
+    ----------
+    in_cutoff : torch.Tensor
+        Boolean mask selecting the unique pairs within the cutoff.
+    i_pairs : torch.Tensor
+        Indices of the first atom in each unique pair.
+    j_pairs : torch.Tensor
+        Indices of the second atom in each unique pair.
+    r_ij : torch.Tensor
+        Displacement vectors for each unique pair. Shape: [n_pairs, 3].
+    d_ij : torch.Tensor
+        Distances for each unique pair. Shape: [n_pairs, 1].
+    only_unique_pairs : bool
+        Whether to only return unique pairs.
+    positions : torch.Tensor
+        Atomic positions, used to infer device and dtype.
+
+    Returns
+    -------
+    PairlistData
+        Contains pair indices, distances (d_ij), and displacement vectors (r_ij).
+    """
+    total_pairs = in_cutoff.sum()
+
+    if only_unique_pairs:
+        # using this instead of torch.stack to ensure that if we only have a single pair
+        # we don't run into an issue with tensor shapes.
+        # note this will fail if there are no interacting pairs
+        pairs = torch.zeros(2, total_pairs, dtype=torch.int64, device=positions.device)
+
+        pairs[0] = i_pairs[in_cutoff]
+        pairs[1] = j_pairs[in_cutoff]
+
+        return PairlistData(
+            pair_indices=pairs,
+            d_ij=d_ij[in_cutoff],
+            r_ij=r_ij[in_cutoff],
+        )
+
+    r_ij_full = torch.zeros(
+        total_pairs * 2, 3, dtype=positions.dtype, device=positions.device
+    )
+    d_ij_full = torch.zeros(
+        total_pairs * 2, 1, dtype=positions.dtype, device=positions.device
+    )
+
+    temp = r_ij[in_cutoff]
+    # i, j pairs
+    r_ij_full[0:total_pairs] = temp
+    # j, i pairs, require we swap the sign
+    r_ij_full[total_pairs : 2 * total_pairs] = -temp
+
+    temp = d_ij[in_cutoff]
+    d_ij_full[0:total_pairs] = temp
+    d_ij_full[total_pairs : 2 * total_pairs] = temp
+
+    temp1 = i_pairs[in_cutoff]
+    temp2 = j_pairs[in_cutoff]
+
+    pairs = torch.zeros(
+        2, total_pairs * 2, dtype=torch.int64, device=positions.device
+    )
+
+    pairs[0][0:total_pairs] = temp1
+    pairs[1][0:total_pairs] = temp2
+    pairs[0][total_pairs : 2 * total_pairs] = temp2
+    pairs[1][total_pairs : 2 * total_pairs] = temp1
+
+    return PairlistData(
+        pair_indices=pairs,
+        d_ij=d_ij_full,
+        r_ij=r_ij_full,
+    )
 
 
