+// parseSpecAddress parses a CIDR-formatted address string, returning both the
+// host IP and the containing network. Missing or invalid values yield nil.
+func parseSpecAddress(address string) (*net.IP, *net.IPNet) {
+	if address == "" {
+		return nil, nil
+	}
+	addr, ipNet, err := net.ParseCIDR(address)
+	if err != nil {
+		return nil, nil
+	}
+	return &addr, ipNet
+}
