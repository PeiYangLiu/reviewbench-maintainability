+// jwtError wraps a user-friendly error message together with the original
+// underlying error so that both can be accessed at the point of logging.
+type jwtError struct {
+	friendly string
+	cause    error
+}
+
+func newJWTError(cause error, friendly string) *jwtError {
+	return &jwtError{friendly: friendly, cause: cause}
+}
+
+func (e *jwtError) Error() string {
+	return e.friendly
+}
+
+func (e *jwtError) Unwrap() error {
+	return e.cause
+}
