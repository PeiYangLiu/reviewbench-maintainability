+// relativePathToWorkdir returns the given path relative to the working
+// directory, falling back to the path's base name if it cannot be resolved.
+func relativePathToWorkdir(wd, path string) string {
+	subpath := path
+	if filepath.IsAbs(subpath) {
+		rel, err := filepath.Rel(wd, path)
+		if err != nil || strings.HasPrefix(rel, "..") {
+			oktetoLog.Info("could not retrieve subpath")
+			subpath = filepath.Base(path)
+		} else {
+			subpath = rel
+		}
+	}
+	return subpath
 }
 
