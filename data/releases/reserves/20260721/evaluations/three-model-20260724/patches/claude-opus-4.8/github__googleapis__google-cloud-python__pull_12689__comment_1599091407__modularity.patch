+class Extractor:
+    """Base class for extracting CloudClients from a GitHub repo listing.
+
+    Subclasses customize the repo path format, the JSON key that identifies a
+    repo, and whether a repo should be included, so that the extraction logic
+    lives in one place instead of being sprinkled with ``if is_split_repo``.
+    """
+
+    path_format: str = None
+    repos_key: str = None
+
+    def allowed_repo(self, repo) -> bool:
+        return True
+
+    def client_for_repo(self, repo_slug) -> Optional[CloudClient]:
+        path = self.path_format.format(repo_slug=repo_slug)
+        url = f"{RAW_CONTENT_BASE_URL}/{path}/{REPO_METADATA_FILENAME}"
+        response = requests.get(url)
+        if response.status_code != requests.codes.ok:
+            return
+
+        return CloudClient(response.json())
+
+    def get_clients_batch_from_response_json(self, response_json) -> List[CloudClient]:
+        return [
+            self.client_for_repo(repo[self.repos_key])
+            for repo in response_json
+            if self.allowed_repo(repo)
+        ]
+
+
+class MonoRepoExtractor(Extractor):
+    path_format = MONO_REPO_PATH_FORMAT
+    repos_key = PACKAGE_RESPONSE_KEY
+
+
+class SplitRepoExtractor(Extractor):
+    path_format = SPLIT_REPO_PATH_FORMAT
+    repos_key = REPO_RESPONSE_KEY
+
+    def allowed_repo(self, repo) -> bool:
+        return allowed_repo(repo)
 
 
