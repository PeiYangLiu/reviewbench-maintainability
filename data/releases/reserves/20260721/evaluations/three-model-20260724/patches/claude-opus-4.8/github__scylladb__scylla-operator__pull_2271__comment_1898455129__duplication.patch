+// scyllaDBClusterDCRackProperties holds the properties of a datacenter's rack that are relevant for update validation.
+type scyllaDBClusterDCRackProperties struct {
+	datacenter string
+	rack       string
+	storage    *scyllav1alpha1.StorageOptions
+	fieldPath  *field.Path
+}
+
+// collectScyllaDBClusterRacks collects the racks of all datacenters, including the ones defined in the datacenter template.
+func collectScyllaDBClusterRacks(sc *scyllav1alpha1.ScyllaDBCluster, fldPath *field.Path) []scyllaDBClusterDCRackProperties {
+	var racks []scyllaDBClusterDCRackProperties
+	for dcIdx, dc := range sc.Spec.Datacenters {
+		if sc.Spec.DatacenterTemplate != nil {
+			for rackIdx, rack := range sc.Spec.DatacenterTemplate.Racks {
+				dcr := scyllaDBClusterDCRackProperties{
+					datacenter: dc.Name,
+					rack:       rack.Name,
+					fieldPath:  fldPath.Child("datacenterTemplate", "racks").Index(rackIdx),
+				}
+				if rack.ScyllaDB != nil {
+					dcr.storage = rack.ScyllaDB.Storage
+				}
+
+				racks = append(racks, dcr)
+			}
+		}
+		for rackIdx, rack := range dc.Racks {
+			dcr := scyllaDBClusterDCRackProperties{
+				datacenter: dc.Name,
+				rack:       rack.Name,
+				fieldPath:  fldPath.Child("datacenters").Index(dcIdx).Child("racks").Index(rackIdx),
+			}
+			if rack.ScyllaDB != nil {
+				dcr.storage = rack.ScyllaDB.Storage
+			}
+
+			racks = append(racks, dcr)
+		}
+	}
+	return racks
+}
