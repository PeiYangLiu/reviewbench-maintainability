+// attributeToStringPair serializes each attribute to a string. Slice
+// attributes are serialized as a JSON list string.
+func attributeToStringPair(kv attribute.KeyValue) string {
+	switch kv.Value.Type() {
+	case attribute.BOOLSLICE:
+		json, _ := json.Marshal(kv.Value.AsBoolSlice())
+		return (string)(json)
+	case attribute.INT64SLICE:
+		json, _ := json.Marshal(kv.Value.AsInt64Slice())
+		return (string)(json)
+	case attribute.FLOAT64SLICE:
+		json, _ := json.Marshal(kv.Value.AsFloat64Slice())
+		return (string)(json)
+	case attribute.STRINGSLICE:
+		json, _ := json.Marshal(kv.Value.AsStringSlice())
+		return (string)(json)
+	default:
+		return kv.Value.Emit()
+	}
+}
