+
+export function resolveAccountConnection(
+    serviceType: AuthProvider['serviceType'],
+    account: NormalizedExternalAccount
+): JSX.Element | string {
+    switch (serviceType) {
+        case 'openidconnect':
+        case 'saml':
+        case 'gerrit':
+            return account.external?.displayName || 'Not connected'
+        case 'azuredevops':
+            return (
+                <>
+                    {account.external?.displayName ? (
+                        <>
+                            {account.external.displayName} (@{account.external?.login})
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+        default:
+            return (
+                <>
+                    {account.external?.url ? (
+                        <>
+                            {account.external.displayName} (
+                            <Link to={account.external.url} target="_blank" rel="noopener noreferrer">
+                                @{account.external.login}
+                            </Link>
+                            )
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+    }
+}
 
 interface Props {
     account: NormalizedExternalAccount
