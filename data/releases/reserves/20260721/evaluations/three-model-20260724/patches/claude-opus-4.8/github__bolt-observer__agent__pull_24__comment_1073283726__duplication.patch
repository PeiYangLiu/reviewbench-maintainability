+// doAndDecode - executes the request and decodes a successful JSON response into target
+func (h *HTTPAPI) doAndDecode(req *http.Request, target interface{}) error {
+	resp, err := h.Do(req)
+
+	if err != nil {
+		return fmt.Errorf("http request failed %s", err)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("http got error %d", resp.StatusCode)
+	}
+
+	defer resp.Body.Close()
+
+	decoder := json.NewDecoder(resp.Body)
+
+	if err := decoder.Decode(target); err != nil {
+		return fmt.Errorf("got error %v", err)
+	}
+
+	return nil
+}
