+    @staticmethod
+    def _collect_variable_attrs(data, data_variables):
+        """
+        Collects the data type and encoding attributes (no data value, scale factor, offset) for each data variable.
+
+        Parameters
+        ----------
+        data : xr.Dataset
+            Dataset to extract the attributes from.
+        data_variables : list of str
+            Data variables to collect the attributes for.
+
+        Returns
+        -------
+        nodatavals, scale_factors, offsets, dtypes : dict
+            Dictionaries mapping each data variable to its respective attribute value.
+
+        """
+        nodatavals = dict()
+        scale_factors = dict()
+        offsets = dict()
+        dtypes = dict()
+        for data_variable in data_variables:
+            dtypes[data_variable] = data[data_variable].data.dtype.name
+            nodatavals[data_variable] = data[data_variable].attrs.get('_FillValue', 0)
+            scale_factors[data_variable] = data[data_variable].attrs.get('scale_factor', 1)
+            offsets[data_variable] = data[data_variable].attrs.get('add_offset', 0)
+        return nodatavals, scale_factors, offsets, dtypes
+
