+def get_socket_from_request(request):
+    """Return the underlying socket (or waitress channel) for a request.
+
+    The way to reach the socket depends on the WSGI server in use, which in
+    turn depends on the platform: `waitress` on Windows and `gunicorn`
+    elsewhere. This helper hides that complexity and returns the object that
+    can be used to close the connection, or `None` if it is not available
+    (e.g. in unit tests).
+    """
+    if platform.system().lower() == "windows":
+        return request.environ.get("waitress.channel", None)
+    return request.environ.get("gunicorn.socket", None)
+
