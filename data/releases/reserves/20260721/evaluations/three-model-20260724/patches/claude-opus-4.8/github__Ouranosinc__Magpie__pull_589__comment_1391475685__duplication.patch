+    def get_user_network_nodes(self, user_name):
+        # type: (Str) -> List[Tuple[Str, Optional[Str]]]
+        """
+        Retrieve the available network nodes with the corresponding remote user name mapped for the given user.
+
+        .. todo::
+            Until the API is modified to make it possible to request from the network tables,
+            we have to access the database directly here.
+        """
+        session = self.request.db
+        network_remote_users = (session.query(NetworkRemoteUser)
+                                .join(User).filter(User.user_name == user_name)
+                                .all())
+        existing_network_remote_user_nodes = {nu.network_node_id: nu.name for nu in network_remote_users}
+        network_nodes = session.query(NetworkNode).order_by(NetworkNode.id).all()
+        return [(n.name, existing_network_remote_user_nodes.get(n.id)) for n in network_nodes]
