+sealed class EnrollmentIconData {
+    data class Data(val color: Int, val imageResource: Int) : EnrollmentIconData()
+    data class Remaining(val remainingEnrollments: Int) : EnrollmentIconData()
+}
+
+fun List<Program>.getEnrollmentIconsData(
+    context: Context,
+    currentProgram: String?
+): List<EnrollmentIconData> {
+    val enrollmentIconsData = mutableListOf<EnrollmentIconData>()
+    val listSize = this.size
+    var programCount = 0
+    for (program in filter { it.uid() != currentProgram }) {
+        val color = ColorUtils.getColorFrom(
+            program.style().color(),
+            ColorUtils.getPrimaryColor(
+                context,
+                ColorUtils.ColorType.PRIMARY
+            )
+        )
+        programCount++
+        if (programCount >= ENROLLMENT_ICONS_TO_SHOW && listSize > ENROLLMENT_ICONS_TO_SHOW) {
+            enrollmentIconsData.add(
+                EnrollmentIconData.Remaining(getOtherEnrollmentsForTei(listSize))
+            )
+            break
+        } else {
+            val imageResource = ResourceManager(context)
+                .getObjectStyleDrawableResource(
+                    program.style().icon(),
+                    R.drawable.ic_default_icon
+                )
+            enrollmentIconsData.add(EnrollmentIconData.Data(color, imageResource))
+        }
+    }
+    return enrollmentIconsData
+}
