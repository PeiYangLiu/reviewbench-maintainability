+
+// firstPrivateIPv4 returns the first private IPv4 address found among the
+// machine's private IP interfaces, or an empty string if none is available.
+func firstPrivateIPv4(machineInfo *machineinfo.MachineInfo) string {
+	if machineInfo == nil || machineInfo.NICInfo == nil {
+		return ""
+	}
+	for _, iface := range machineInfo.NICInfo.PrivateIPInterfaces {
+		if iface.IP == "" {
+			continue
+		}
+		if iface.Addr.IsPrivate() && iface.Addr.Is4() {
+			return iface.IP
+		}
+	}
+	return ""
+}
