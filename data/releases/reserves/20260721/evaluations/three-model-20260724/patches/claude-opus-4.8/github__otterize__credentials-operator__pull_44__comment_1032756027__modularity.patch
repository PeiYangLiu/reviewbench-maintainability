+
+// buildSecretData builds the Kubernetes secret data map explicitly, so that the
+// naming of the secret keys is owned by this package rather than depending on a
+// map produced elsewhere. This makes it clear to a reader what a TLS secret
+// contains without having to read the certificate generation code.
+func buildSecretData(certConfig secretstypes.CertConfig, certificateData secretstypes.CertificateData) map[string][]byte {
+	switch certConfig.CertType {
+	case secretstypes.JKSCertType:
+		return map[string][]byte{
+			certConfig.JksConfig.KeyStoreFileName:   certificateData.JKS.KeyStore,
+			certConfig.JksConfig.TrustStoreFileName: certificateData.JKS.TrustStore,
+		}
+	default:
+		return map[string][]byte{
+			certConfig.PemConfig.SvidFileName:   certificateData.PEM.SVID,
+			certConfig.PemConfig.BundleFileName: certificateData.PEM.Bundle,
+			certConfig.PemConfig.KeyFileName:    certificateData.PEM.Key,
+		}
+	}
 }
 
