+// getTransientChildren returns the given node and all of its descendants
+func (woc *wfOperationCtx) getTransientChildren(nodeID string) []wfv1.NodeStatus {
+	node := woc.wf.Status.Nodes[nodeID]
+	children := []wfv1.NodeStatus{}
+	q := []wfv1.NodeStatus{node}
+	for len(q) > 0 {
+		childNode := q[0]
+		q = q[1:]
+		for _, childID := range childNode.Children {
+			q = append(q, woc.wf.Status.Nodes[childID])
+		}
+		children = append(children, childNode)
+	}
+	return children
+}
