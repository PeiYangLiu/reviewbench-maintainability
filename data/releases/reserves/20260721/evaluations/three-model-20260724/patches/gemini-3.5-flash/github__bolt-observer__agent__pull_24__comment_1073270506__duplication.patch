+// GetInvoicesRaw - API call
+func (l *ClnSocketLightningAPI) GetInvoicesRaw(ctx context.Context, pendingOnly bool, pagination RawPagination) ([]RawMessage, *ResponseRawPagination, error) {
+	var reply ClnRawInvoices
+
+	err := l.CallWithTimeout(LISTINVOICES, []interface{}{}, &reply)
+	if err != nil {
+		return nil, &ResponseRawPagination{UseTimestamp: true}, err
+	}
+
+	return l.processRawEntries(reply.Entries, func(one []byte) (int64, error) {
+		var gettime ClnRawInvoiceTime
+		if err := json.Unmarshal(one, &gettime); err != nil {
+			return 0, err
+		}
+		return int64(gettime.Time), nil
+	})
+}
