+def is_matching_type(frictionless_type: FieldType, dtype: pl.DataType) -> bool:
+    """Check if the given Frictionless type matches the Polars type.
+
+    Args:
+        frictionless_type: The Frictionless type.
+        dtype: The Polars type.
+
+    Returns:
+        True if the types match, False otherwise.
+    """
+    match frictionless_type:
+        case "number":
+            return dtype.is_float() or dtype.is_decimal()
+        case "integer":
+            return dtype.is_integer() or isinstance(dtype, pl.Duration)
+        case "string":
+            return isinstance(dtype, (pl.String, pl.Categorical, pl.Enum, pl.Binary))
+        case "date":
+            return isinstance(dtype, pl.Date)
+        case "datetime":
+            return isinstance(dtype, pl.Datetime)
+        case "time":
+            return dtype == pl.Time
+        case "boolean":
+            return isinstance(dtype, pl.Boolean)
+        case "array":
+            return isinstance(dtype, (pl.String, pl.Array, pl.List))
+        case "object":
