+    def _start_server(
+        self,
+        name: str,
+        bind_addr: Tuple[str, int],
+        ssl_info: Any,
+        mounts: List[Tuple[Any, str, Any]]
+    ) -> ServerAdapter:
+        self.mgr.log.info(f'Starting {name} server on {bind_addr[0]}:{bind_addr[1]}...')
+        tree = _cptree.Tree()
+        for app, path, config in mounts:
+            tree.mount(app, path, config=config)
+        adapter, _ = CherryPyMgr.mount(
+            tree,
+            name,
+            bind_addr,
+            ssl_info=ssl_info
+        )
+        return adapter
+
