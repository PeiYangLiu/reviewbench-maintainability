+type eventAttributes struct {
+	CommandName              string
+	DatabaseName             string
+	Hostname                 string
+	Port                     int
+	Command                  bson.Raw
+	CommandAttributeDisabled bool
+	Collection               string
+}
+
+func (e eventAttributes) Attributes() []attribute.KeyValue {
+	attrs := make([]attribute.KeyValue, 0, 8)
+	attrs = append(attrs, semconv.DBSystemMongoDB)
+
+	if e.CommandName != "" {
+		attrs = append(attrs, semconv.DBOperationNameKey.String(e.CommandName))
+	}
+	if e.DatabaseName != "" {
+		attrs = append(attrs, semconv.DBNamespaceKey.String(e.DatabaseName))
+	}
+	if e.Port > 0 {
+		attrs = append(attrs, semconv.NetworkPeerPortKey.Int(e.Port))
+	}
+	if e.Hostname != "" {
+		attrs = append(attrs, semconv.NetworkPeerAddressKey.String(e.Hostname))
+	}
+	attrs = append(attrs, semconv.NetworkTransportTCP)
+
+	if !e.CommandAttributeDisabled {
+		attrs = append(attrs, semconv.DBQueryTextKey.String(sanitizeCommand(e.Command)))
+	}
+
+	if e.Collection != "" {
+		attrs = append(attrs, semconv.DBCollectionNameKey.String(e.Collection))
+	}
+
+	return attrs
+}
