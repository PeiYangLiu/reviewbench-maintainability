+func appendAttributes(m map[string]string, attrs []attribute.KeyValue) {
+	for _, kv := range attrs {
+		switch kv.Value.Type() {
+		// For slice attributes, serialize as JSON list string.
+		case attribute.BOOLSLICE:
+			js, _ := json.Marshal(kv.Value.AsBoolSlice())
+			m[string(kv.Key)] = string(js)
+		case attribute.INT64SLICE:
+			js, _ := json.Marshal(kv.Value.AsInt64Slice())
+			m[string(kv.Key)] = string(js)
+		case attribute.FLOAT64SLICE:
+			js, _ := json.Marshal(kv.Value.AsFloat64Slice())
+			m[string(kv.Key)] = string(js)
+		case attribute.STRINGSLICE:
+			js, _ := json.Marshal(kv.Value.AsStringSlice())
+			m[string(kv.Key)] = string(js)
+		default:
+			m[string(kv.Key)] = kv.Value.Emit()
+		}
+	}
+}
