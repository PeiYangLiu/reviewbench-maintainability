+def renamed_key(keys, key):
+    """Normalize key names to handle different field name variants (renames)
+
+    Returns the actual key name present in `keys` if it or its alias matches `key`.
+    """
+    if key in keys:
+        return key
+
+    renames = {
+        "mchunk_size": "size",
+        "mchunk_prev_size": "prev_size",
+    }
+    for k in keys:
+        if renames.get(k, k) == renames.get(key, key):
+            return k
+    return key
+
