+
+func (c *connector) getConnector(ctx context.Context, sessionCtx *common.Session, dsnConfig msdsn.Config) (*mssql.Connector, error) {
+	if sessionCtx.Database.IsAzure() && sessionCtx.Database.GetAD().Domain == "" {
+		// If the client is connecting to Azure SQL, and no AD configuration is
+		// provided, authenticate using the Azure AD Integrated authentication
+		// method.
+		managedIdentityID, err := c.DBAuth.GetAzureIdentityResourceID(ctx, sessionCtx.DatabaseUser)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+
+		connector, err := azuread.NewConnectorFromConfig(dsnConfig, map[string]string{
+			"fedauth":     azuread.ActiveDirectoryManagedIdentity,
+			"resource id": managedIdentityID,
+		})
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return connector, nil
+	}
+
+	var kt *client.Client
+	var err error
+	if sessionCtx.Database.GetAD().KeytabFile != "" {
+		kt, err = keytabClient(sessionCtx)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	} else if sessionCtx.Database.GetAD().KDCHostName != "" && sessionCtx.Database.GetAD().LDAPCert != "" {
+		kt, err = kinitClient(ctx, sessionCtx, c.AuthClient, c.DataDir)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	} else {
+		return nil, trace.Wrap(fmt.Errorf("configuration must have either keytab or kdc_host_name and ldap_cert"))
+	}
+
+	auth, err := c.getAuth(sessionCtx, kt)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	return mssql.NewConnectorConfig(dsnConfig, auth), nil
+}
