 var _ caddy.GracefulServer = new(Server)
+
+func newServer(addr string, group []*Config) (caddy.Server, error) {
+	tr, _ := parse.Transport(addr)
+	switch tr {
+	case transport.DNS:
+		return NewServer(addr, group)
+	case transport.TLS:
+		return NewServerTLS(addr, group)
+	case transport.QUIC:
+		return NewServerQUIC(addr, group)
+	case transport.GRPC:
+		return NewServergRPC(addr, group)
+	case transport.HTTPS:
+		return NewServerHTTPS(addr, group)
+	}
+	return nil, nil
+}
+
+func defaultPortForTransport(trans string) string {
+	switch trans {
+	case transport.DNS:
+		return Port
+	case transport.TLS:
+		return transport.TLSPort
+	case transport.QUIC:
+		return transport.QUICPort
+	case transport.GRPC:
+		return transport.GRPCPort
+	case transport.HTTPS:
+		return transport.HTTPSPort
+	}
+	return ""
+}
