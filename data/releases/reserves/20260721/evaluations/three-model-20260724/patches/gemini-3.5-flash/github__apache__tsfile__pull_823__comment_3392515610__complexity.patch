+#define DEFINE_PLAIN_SKIP_METHOD(name, type, size, read_func)                  \
+    int name(int count, int& skipped, common::ByteStream& in) override {       \
+        skipped = 0;                                                           \
+        if (!in.is_wrapped()) {                                                \
+            type dummy;                                                        \
+            while (skipped < count && in.has_remaining()) {                    \
+                int ret = common::SerializationUtil::read_func(dummy, in);     \
+                if (ret != common::E_OK) return ret;                           \
+                ++skipped;                                                     \
+            }                                                                  \
+            return common::E_OK;                                               \
+        }                                                                      \
+        skipped = static_cast<int>(std::min<uint32_t>(                         \
+            in.remaining_size() / (size), static_cast<uint32_t>(count)));      \
+        if (skipped <= 0) {                                                    \
+            skipped = 0;                                                       \
+            return common::E_OK;                                               \
+        }                                                                      \
+        in.wrapped_buf_advance_read_pos(static_cast<uint32_t>(skipped) *       \
+                                        (size));                               \
+        return common::E_OK;                                                   \
+    }
+
+#define DEFINE_PLAIN_READ_BATCH_METHOD(name, type, size, read_func,            \
+                                       bswap_type, bswap_func)                 \
+    int name(type* out, int capacity, int& actual,                             \
+             common::ByteStream& in) override {                                \
+        actual = 0;                                                            \
+        if (!in.is_wrapped()) {                                                \
+            while (actual < capacity && in.has_remaining()) {                  \
+                int ret =                                                      \
+                    common::SerializationUtil::read_func(out[actual], in);     \
+                if (ret != common::E_OK) return ret;                           \
+                ++actual;                                                      \
+            }                                                                  \
+            return common::E_OK;                                               \
+        }                                                                      \
+        int n = static_cast<int>(std::min<uint32_t>(                           \
+            in.remaining_size() / (size), static_cast<uint32_t>(capacity)));   \
+        if (n <= 0) return common::E_OK;                                       \
+                                                                               \
+        const uint8_t* src =                                                   \
+            (const uint8_t*)in.get_wrapped_buf() + in.read_pos();              \
+        in.wrapped_buf_advance_read_pos(static_cast<uint32_t>(n) * (size));    \
+        actual = n;                                                            \
+        for (int i = 0; i < n; ++i) {                                          \
+            bswap_type v;                                                      \
+            memcpy(&v, src + i * (size), (size));                              \
+            v = bswap_func(v);                                                 \
+            memcpy(&out[i], &v, (size));                                       \
+        }                                                                      \
+        return common::E_OK;                                                   \
+    }
