+func (t *MultiTSDB) extLabelsForTenant(tenantID string, initialLabels labels.Labels) (labels.Labels, error) {
+	for _, hc := range t.hashringConfigs {
+		for _, tenant := range hc.Tenants {
+			if tenant == tenantID {
+				lset, err := parseAndExtendSortedLabels(initialLabels, hc.ExternalLabels, t.logger)
+				if err != nil {
+					return nil, errors.Wrap(err, "failed to parse external labels for tenant "+tenantID)
+				}
+				return lset, nil
+			}
+		}
+	}
+	return initialLabels, nil
+}
