+@jit(nopython=True)
+def _evaluate_kernels(receiver, nodes, kernel_func, kernels):
+    """
+    Evaluate the kernel function for a single receiver on all nodes.
+    """
+    n_nodes = nodes.shape[0]
+    for j in range(n_nodes):
+        dx = nodes[j, 0] - receiver[0]
+        dy = nodes[j, 1] - receiver[1]
+        dz = nodes[j, 2] - receiver[2]
+        distance = np.sqrt(dx**2 + dy**2 + dz**2)
+        kernels[j] = kernel_func(dx, dy, dz, distance)
+
+
+@jit(nopython=True)
+def _prism_combination(kernels, cell_nodes, k):
+    """
+    Compute the linear combination of kernels for the 8 nodes of a prism.
+    """
+    return (
+        -kernels[cell_nodes[k, 0]]
+        + kernels[cell_nodes[k, 1]]
+        + kernels[cell_nodes[k, 2]]
+        - kernels[cell_nodes[k, 3]]
+        + kernels[cell_nodes[k, 4]]
+        - kernels[cell_nodes[k, 5]]
+        - kernels[cell_nodes[k, 6]]
+        + kernels[cell_nodes[k, 7]]
+    )
 
 
