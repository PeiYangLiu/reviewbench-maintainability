+// Option configures a Group.
+type Option func(*group)
+
+// WithContext returns an Option that associates a Context with the Group.
+// The context will be canceled if any goroutine returns an error.
+func WithContext(ctx context.Context) Option {
+	return func(g *group) {
+		g.ctx, g.cancel = context.WithCancel(ctx)
+	}
+}
+
+// WithPanicHandler returns an Option that sets a panic handler for the group.
+func WithPanicHandler(f func(any)) Option {
+	return func(g *group) {
+		g.panicHandler = f
+	}
+}
