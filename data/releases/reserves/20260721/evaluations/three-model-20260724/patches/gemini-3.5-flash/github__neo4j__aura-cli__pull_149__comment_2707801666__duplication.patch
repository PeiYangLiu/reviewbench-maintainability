+func setupOrgAndProjectFlags(cmd *cobra.Command, cfg *clicfg.Config, orgFlag, projFlag string) {
+	cmd.PreRunE = func(cmd *cobra.Command, args []string) error {
+		defaultSetting, err := cfg.Settings.Aura.GetDefault()
+		if err != nil {
+			log.Fatal(err)
+		}
+		if defaultSetting.OrganizationId == "" {
+			if err := cmd.MarkFlagRequired(orgFlag); err != nil {
+				log.Fatal(err)
+			}
+		}
+		if defaultSetting.ProjectId == "" {
+			if err := cmd.MarkFlagRequired(projFlag); err != nil {
+				log.Fatal(err)
+			}
+		}
+		return nil
+	}
+}
+
+func resolveOrgAndProjectDefaults(cfg *clicfg.Config, orgId, projId *string) {
+	defaultSetting, err := cfg.Settings.Aura.GetDefault()
+	if err != nil {
+		log.Fatal(err)
+	}
+	if *orgId == "" {
+		*orgId = defaultSetting.OrganizationId
+	}
+	if *projId == "" {
+		*projId = defaultSetting.ProjectId
+	}
+}
