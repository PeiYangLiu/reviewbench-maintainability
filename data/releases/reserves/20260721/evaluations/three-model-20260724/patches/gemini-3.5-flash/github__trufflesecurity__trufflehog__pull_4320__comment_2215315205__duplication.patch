+func (s *Source) fetchAllProjectRepos(
+	ctx context.Context,
+	apiClient *gitlab.Client,
+	ignoreRepo func(string) bool,
+	reporter sources.UnitReporter,
+) error {
+	if len(s.groupIds) > 0 {
+		return s.getAllProjectReposInGroup(ctx, apiClient, s.groupIds, ignoreRepo, reporter)
+	}
+	if feature.UseSimplifiedGitlabEnumeration.Load() {
+		return s.getAllProjectReposV2(ctx, apiClient, ignoreRepo, reporter)
+	}
+	return s.getAllProjectRepos(ctx, apiClient, ignoreRepo, reporter)
+}
+
+func (s *Source) cloneRepo(ctx context.Context, repoURL string) (string, *gogit.Repository, error) {
+	if s.authMethod == "UNAUTHENTICATED" {
+		return git.CloneRepoUsingUnauthenticated(ctx, repoURL)
+	}
+	// If a username is not provided we need to use a default one in order to clone a private repo.
+	// Not setting "placeholder" as s.user on purpose in case any downstream services rely on a "" value for s.user.
+	user := s.user
+	if user == "" {
+		user = "placeholder"
+	}
+	return git.CloneRepoUsingToken(ctx, s.token, repoURL, user, s.useAuthInUrl)
 }
 
