+
+  implicit val functionTypeInstance: ToBlockType[FunctionType] =
+    new ToBlockType[FunctionType] {
+      def toBlockType(builder: FunctionBuilder, value: FunctionType): BlockType =
+        builder.sigToBlockType(value)
+    }
+
+  implicit val listTypeInstance: ToBlockType[List[Type]] =
+    new ToBlockType[List[Type]] {
+      def toBlockType(builder: FunctionBuilder, value: List[Type]): BlockType =
+        builder.sigToBlockType(FunctionType(Nil, value))
+    }
+}
+
+private sealed trait ToFunctionType[-T] {
+  def toFunctionType(value: T): FunctionType
+}
+
+private object ToFunctionType {
+  implicit val functionTypeInstance: ToFunctionType[FunctionType] =
