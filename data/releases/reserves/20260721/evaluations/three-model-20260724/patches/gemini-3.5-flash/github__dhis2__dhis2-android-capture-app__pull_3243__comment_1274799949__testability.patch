+data class EnrollmentIconsData(
+    val icons: List<EnrollmentIconData>,
+    val remainingCount: Int
+)
+
+data class EnrollmentIconData(
+    val color: Int,
+    val imageResource: Int
+)
+
+fun List<Program>.getEnrollmentIconsData(
+    context: Context,
+    currentProgram: String?
+): EnrollmentIconsData {
+    val listSize = this.size
+    val icons = mutableListOf<EnrollmentIconData>()
+    var remainingCount = 0
+    var programCount = 0
+
+    filter { it.uid() != currentProgram }
+        .forEach { program ->
+            programCount++
+            if (programCount >= 4 && listSize > 4) {
+                remainingCount = getOtherEnrollmentsForTei(listSize)
+                return EnrollmentIconsData(icons, remainingCount)
+            } else {
+                val color = ColorUtils.getColorFrom(
+                    program.style().color(),
+                    ColorUtils.getPrimaryColor(
+                        context,
+                        ColorUtils.ColorType.PRIMARY
+                    )
+                )
+                val imageResource =
+                    ResourceManager(context)
+                        .getObjectStyleDrawableResource(
+                            program.style().icon(),
+                            R.drawable.ic_default_icon
+                        )
+                icons.add(EnrollmentIconData(color, imageResource))
+            }
+        }
+    return EnrollmentIconsData(icons, remainingCount)
+}
