+// registerFailedConnectionTo registers a failed connection attempt to the given
+// address or globally if there is no address. It returns whether the connection
+// request should be dropped (e.g., if banned or global threshold is reached).
+func (cm *ConnManager) registerFailedConnectionTo(c *ConnReq) bool {
+	if c.Addr != nil && c.Addr.String() != "" && cm.cfg.BanAddress != nil {
+		addrStr := c.Addr.String()
+		cm.incAddrConnAttempt(addrStr)
+		if cm.getAddrConnAttempt(addrStr) >= maxFailedAttempts {
+			cm.cfg.BanAddress(addrStr)
+			return true
+		}
+	} else {
+		cm.incGlobalFailedAttempts()
+		if cm.getGlobalFailedAttempts() >= maxFailedAttempts {
+			cm.log.Debug().Msgf("Max failed connection attempts reached: [%d] "+
+				"-- retrying connection in: %v", maxFailedAttempts,
+				cm.cfg.RetryDuration)
+			time.AfterFunc(cm.cfg.RetryDuration, func() {
+				cm.NewConnReq()
+			})
+			return true
+		}
+	}
+	return false
+}
+
