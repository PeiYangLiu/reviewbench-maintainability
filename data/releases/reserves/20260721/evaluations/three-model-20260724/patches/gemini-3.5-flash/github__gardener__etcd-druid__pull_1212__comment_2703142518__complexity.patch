+type resourceMeta struct {
+	GVR        schema.GroupVersionResource
+	Kind       string
+	Namespaced bool
+}
+
+func resolveTokens(mapper meta.RESTMapper, tokens []string) ([]resourceMeta, error) {
+	var metas []resourceMeta
+	seen := make(map[schema.GroupVersionResource]struct{})
+	for _, token := range tokens {
+		gvr := schema.GroupVersionResource{Resource: token}
+		fullyQualifiedGVR, err := mapper.ResourceFor(gvr)
+		if err != nil {
+			return nil, fmt.Errorf("failed to resolve resource %q: %w", token, err)
+		}
+		if _, ok := seen[fullyQualifiedGVR]; ok {
+			continue
+		}
+		seen[fullyQualifiedGVR] = struct{}{}
+
+		gvk, err := mapper.KindFor(fullyQualifiedGVR)
+		if err != nil {
+			return nil, fmt.Errorf("failed to get kind for resource %q: %w", token, err)
+		}
+
+		mapping, err := mapper.RESTMapping(gvk.GroupKind(), gvk.Version)
+		if err != nil {
+			return nil, fmt.Errorf("failed to get REST mapping for resource %q: %w", token, err)
+		}
+
+		metas = append(metas, resourceMeta{
+			GVR:        fullyQualifiedGVR,
+			Kind:       gvk.Kind,
+			Namespaced: mapping.Scope.Name() == meta.RESTScopeNameNamespace,
+		})
+	}
+	return metas, nil
+}
