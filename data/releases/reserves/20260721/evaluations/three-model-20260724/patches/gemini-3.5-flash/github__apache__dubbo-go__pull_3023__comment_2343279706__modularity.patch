+// isToday checks if the file's modification time is today
+func isToday(file *os.File) bool {
+	now := time.Now().Format(FileDateFormat)
+	if fileInfo, err := file.Stat(); err == nil {
+		last := fileInfo.ModTime().Format(FileDateFormat)
+		return now == last
+	}
+	return false
+}
