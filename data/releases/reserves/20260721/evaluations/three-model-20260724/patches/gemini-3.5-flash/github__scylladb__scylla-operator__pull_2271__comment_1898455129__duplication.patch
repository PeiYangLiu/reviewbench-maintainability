+func ValidateStorageOptions(storage *scyllav1alpha1.StorageOptions, fldPath *field.Path) field.ErrorList {
+	allErrs := field.ErrorList{}
+
+	if storage.Metadata != nil {
+		allErrs = append(allErrs, apimachinerymetav1validation.ValidateLabels(storage.Metadata.Labels, fldPath.Child("metadata", "labels"))...)
+		allErrs = append(allErrs, apimachineryvalidation.ValidateAnnotations(storage.Metadata.Annotations, fldPath.Child("metadata", "annotations"))...)
+	}
+
+	storageCapacity, err := resource.ParseQuantity(storage.Capacity)
+	if err != nil {
+		allErrs = append(allErrs, field.Invalid(fldPath.Child("capacity"), storage.Capacity, fmt.Sprintf("unable to parse capacity: %v", err)))
+	} else if storageCapacity.CmpInt64(0) <= 0 {
+		allErrs = append(allErrs, field.Invalid(fldPath.Child("capacity"), storage.Capacity, "must be greater than zero"))
+	}
+
+	if storage.StorageClassName != nil {
+		for _, msg := range apimachineryvalidation.NameIsDNSSubdomain(*storage.StorageClassName, false) {
+			allErrs = append(allErrs, field.Invalid(fldPath.Child("storageClassName"), *storage.StorageClassName, msg))
+		}
+	}
+
+	return allErrs
+}
