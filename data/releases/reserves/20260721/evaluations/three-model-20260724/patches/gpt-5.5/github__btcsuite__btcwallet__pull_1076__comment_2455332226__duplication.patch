+// validateUTXOList ensures the specified UTXO list is not empty and contains
+// no duplicates.
+func validateUTXOList(utxos []wire.OutPoint) error {
+	if len(utxos) == 0 {
+		return ErrManualInputsEmpty
+	}
+
+	seenUTXOs := make(map[wire.OutPoint]struct{})
+	for _, utxo := range utxos {
+		if _, ok := seenUTXOs[utxo]; ok {
+			return ErrDuplicatedUtxo
+		}
+
+		seenUTXOs[utxo] = struct{}{}
+	}
+
+	return nil
+}
