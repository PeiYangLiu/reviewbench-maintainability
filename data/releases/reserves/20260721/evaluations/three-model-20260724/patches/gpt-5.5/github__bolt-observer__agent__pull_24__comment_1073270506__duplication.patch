+func clnRawInvoiceTimestamp(message json.RawMessage) (time.Time, error) {
+	var gettime ClnRawInvoiceTime
+	return clnRawTimestamp(message, &gettime, func() int64 {
+		return int64(gettime.Time)
+	})
+}
+
+func clnRawPaymentTimestamp(message json.RawMessage) (time.Time, error) {
+	var gettime ClnRawPayTime
+	return clnRawTimestamp(message, &gettime, func() int64 {
+		return int64(gettime.Time)
+	})
+}
+
+func clnRawForwardTimestamp(message json.RawMessage) (time.Time, error) {
+	var gettime ClnRawForwardsTime
+	return clnRawTimestamp(message, &gettime, func() int64 {
+		return int64(gettime.Time)
+	})
+}
+
+func clnRawTimestamp(message json.RawMessage, target any, timestamp func() int64) (time.Time, error) {
+	if err := json.Unmarshal(message, target); err != nil {
+		return time.Time{}, err
+	}
+
+	return time.Unix(timestamp(), 0), nil
 }
 
