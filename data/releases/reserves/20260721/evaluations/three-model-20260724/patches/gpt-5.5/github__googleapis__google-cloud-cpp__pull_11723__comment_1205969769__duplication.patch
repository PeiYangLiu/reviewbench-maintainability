+std::string LongrunningOperationSubstitutions(std::string text,
+                                              bool has_grpc_lro) {
+  return absl::StrReplaceAll(
+      text,
+      {{"$longrunning_operation_response_type$",
+        has_grpc_lro ? "google::longrunning::Operation"
+                     : "$longrunning_response_type$"},
+       {"$longrunning_operation_get_request_type$",
+        has_grpc_lro ? "google::longrunning::GetOperationRequest"
+                     : "$longrunning_get_operation_request_type$"},
+       {"$longrunning_operation_cancel_request_type$",
+        has_grpc_lro ? "google::longrunning::CancelOperationRequest"
+                     : "$longrunning_cancel_operation_request_type$"}});
+}
