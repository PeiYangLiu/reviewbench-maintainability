+// doHTTPRequest prepares and executes an HTTP request.
+func (h *HTTPAPI) doHTTPRequest(ctx context.Context, req *http.Request, method string, rawURL string, body io.Reader) (*http.Response, error) {
+	req = req.WithContext(ctx)
+
+	req.Method = method
+
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return nil, fmt.Errorf("invalid url %s", err)
+	}
+
+	req.URL = u
+	if body != nil {
+		req.Body = io.NopCloser(body)
+	}
+
+	resp, err := h.Do(req)
+
+	if err != nil {
+		return nil, fmt.Errorf("http request failed %s", err)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("http got error %d", resp.StatusCode)
+	}
+
+	return resp, nil
+}
