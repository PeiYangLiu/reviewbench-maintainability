+fun List<Program>.getEnrollmentIconsData(
+    context: Context,
+    currentProgram: String?
+): List<EnrollmentIconData> {
+    val listSize = this.size
+    var programCount = 0
+    val enrollmentIconsData = mutableListOf<EnrollmentIconData>()
+    run outer@{
+        filter { it.uid() != currentProgram }
+            .forEach { program ->
+                programCount++
+                if (
+                    programCount >= ENROLLMENT_ICONS_TO_SHOW &&
+                    listSize > ENROLLMENT_ICONS_TO_SHOW
+                ) {
+                    enrollmentIconsData.add(
+                        EnrollmentIconData.RemainingEnrollments(
+                            getOtherEnrollmentsForTei(listSize)
+                        )
+                    )
+                    return@outer
+                } else {
+                    val color = ColorUtils.getColorFrom(
+                        program.style().color(),
+                        ColorUtils.getPrimaryColor(
+                            context,
+                            ColorUtils.ColorType.PRIMARY
+                        )
+                    )
+                    val imageResource =
+                        ResourceManager(context)
+                            .getObjectStyleDrawableResource(
+                                program.style().icon(),
+                                R.drawable.ic_default_icon
+                            )
+                    enrollmentIconsData.add(EnrollmentIconData.Icon(color, imageResource))
+                }
+            }
+    }
+    return enrollmentIconsData
 }
 
