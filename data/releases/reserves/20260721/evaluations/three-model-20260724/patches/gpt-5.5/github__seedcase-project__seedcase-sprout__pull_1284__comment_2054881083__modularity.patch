+def _get_matching_type(dtype: pl.DataType) -> FieldType:
+    """Return the canonical Frictionless type for a Polars type.
+
+    When a Polars type can represent multiple Frictionless types, this function returns
+    the primary Frictionless type used when extracting resource properties.
+    """
+    if dtype.is_float() or dtype.is_decimal():
+        return "number"
+
+    if dtype.is_integer() or isinstance(dtype, pl.Duration):
+        return "integer"
+
+    if isinstance(dtype, (pl.String, pl.Categorical, pl.Enum, pl.Binary)):
+        return "string"
+
+    if isinstance(dtype, pl.Date):
+        return "date"
+
+    if isinstance(dtype, pl.Datetime):
+        return "datetime"
+
+    if dtype == pl.Time:  # Polars stores Time as a class
+        return "time"
+
+    if isinstance(dtype, pl.Boolean):
+        return "boolean"
+
+    if isinstance(dtype, (pl.Array, pl.List)):
+        return "array"
+
+    if isinstance(dtype, (pl.Struct, pl.Object)):
+        return "object"
+
+    return "any"
+
+
+def _frictionless_type_matches_polars(
+    frictionless_type: FieldType,
+    dtype: pl.DataType,
+) -> bool:
+    """Return whether a Polars type is allowed for a Frictionless type."""
+    if frictionless_type == "number":
+        return dtype.is_float() or dtype.is_decimal()
+
+    if frictionless_type == "integer":
+        return dtype.is_integer() or isinstance(dtype, pl.Duration)
+
+    if frictionless_type == "string":
+        return isinstance(dtype, (pl.String, pl.Categorical, pl.Enum, pl.Binary))
+
+    if frictionless_type == "date":
+        return isinstance(dtype, pl.Date)
+
+    if frictionless_type == "datetime":
+        return isinstance(dtype, pl.Datetime)
+
+    if frictionless_type == "time":
+        return dtype == pl.Time  # Polars stores Time as a class
+
+    if frictionless_type == "boolean":
+        return isinstance(dtype, pl.Boolean)
+
+    if frictionless_type == "array":
+        return isinstance(dtype, (pl.String, pl.Array, pl.List))
+
+    if frictionless_type == "object":
+        return isinstance(dtype, (pl.String, pl.Struct, pl.Object))
+
+    if frictionless_type == "geopoint":
+        return isinstance(dtype, pl.Array) and dtype.size == 2 and dtype.inner.is_numeric()
+
+    if frictionless_type == "geojson":
+        return isinstance(dtype, (pl.String, pl.Struct, pl.Object))
+
+    if frictionless_type == "year":
+        return dtype.is_integer()
+
+    if frictionless_type == "yearmonth":
+        return isinstance(dtype, pl.Date)
+
+    if frictionless_type == "duration":
+        return isinstance(dtype, pl.String)
+
+    if frictionless_type == "any":
+        return True
+
+    return False
+
