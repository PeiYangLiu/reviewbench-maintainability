+	/**
+	 * Gets license types in plan order.
+	 *
+	 * @since x.x
+	 *
+	 * @param array|string $args {
+	 *     Optional. Arguments for the returned license types. A string is treated as the case argument.
+	 *
+	 *     @type string $case           Return value case. Supports 'title' and 'lower'. Default 'title'.
+	 *     @type bool   $include_free   Whether to include the free license type. Default false.
+	 *     @type bool   $include_legacy Whether to include legacy license type names. Default false.
+	 * }
+	 * @return array
+	 */
+	public static function get_license_types( $args = array() ) {
+		if ( is_string( $args ) ) {
+			$args = array(
+				'case' => $args,
+			);
+		}
+
+		$args = array_merge(
+			array(
+				'case'           => 'title',
+				'include_free'   => false,
+				'include_legacy' => false,
+			),
+			$args
+		);
+
+		$license_types = $args['include_legacy'] ? array( 'Basic', 'Personal', 'Plus', 'Creator', 'Business', 'Elite' ) : array( 'Basic', 'Plus', 'Business', 'Elite' );
+
+		if ( $args['include_free'] ) {
+			array_unshift( $license_types, 'free' );
+		}
+
+		if ( 'lower' === $args['case'] || 'lowercase' === $args['case'] ) {
+			$license_types = array_map( 'strtolower', $license_types );
+		}
+
+		return $license_types;
 	}
 
