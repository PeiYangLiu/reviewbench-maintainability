+def _translate_full_star(sep, escaped_sep, dot):
+    def translate_star(pat, h, i, n):
+        star_count = i-h
+        is_segment = (h == 0 or pat[h-1] == sep) and (i == n or pat[i] == sep)
+        if star_count == 1:
+            if is_segment:
+                return f'{dot}+', i
+            return f'{dot}*', i
+        if star_count == 2 and is_segment:
+            if i == n:
+                return '.*', i
+            return f'(.*{escaped_sep})?', i+1
+        raise ValueError("Invalid pattern: '**' can only be an entire path component")
+    return translate_star
