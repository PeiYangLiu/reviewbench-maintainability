 from loguru import logger as log
 from modelforge.potential.models import PairlistData
 from modelforge.dataset.dataset import NNPInputTuple
+
+
+def _enumerate_pair_indices(
+    n_particles: int, device: torch.device, only_unique_pairs: bool
+):
+    indices = torch.arange(n_particles, device=device)
+    i_pairs, j_pairs = torch.meshgrid(indices, indices, indexing="ij")
+
+    if only_unique_pairs:
+        pair_mask = i_pairs < j_pairs
+    else:
+        pair_mask = i_pairs != j_pairs
+
+    return indices, i_pairs[pair_mask], j_pairs[pair_mask]
+
+
+def _pairlist_from_pairs(
+    i_pairs: torch.Tensor,
+    j_pairs: torch.Tensor,
+    d_ij: torch.Tensor,
+    r_ij: torch.Tensor,
+    in_cutoff: torch.Tensor,
+    positions: torch.Tensor,
+):
+    total_pairs = in_cutoff.sum()
+
+    pairs = torch.zeros(2, total_pairs, dtype=torch.int64, device=positions.device)
+    pairs[0] = i_pairs[in_cutoff]
+    pairs[1] = j_pairs[in_cutoff]
+
+    return PairlistData(
+        pair_indices=pairs,
+        d_ij=d_ij[in_cutoff],
+        r_ij=r_ij[in_cutoff],
+    )
 
 
