+    /** Method for extracting results from the provided result maps.
+      *
+      * @param uuids
+      *   For which results should be returned.
+      * @param primaryResults
+      *   A map: uuid to primary result.
+      * @param additionalResults
+      *   A map: uuid to additional result.
+      * @return
+      *   A map: uuid to results.
+      */
+    private def resultsFor(
+        uuids: Iterable[UUID],
+        primaryResults: Map[UUID, ResultEntity],
+        additionalResults: Map[UUID, ResultEntity],
+    ): Map[UUID, List[ResultEntity]] =
+      uuids.flatMap { uuid =>
+        (primaryResults.get(uuid), additionalResults.get(uuid)) match {
+          case (Some(res), Some(additional)) =>
+            Some(uuid -> List(res, additional))
+          case (Some(res), None) =>
+            Some(uuid -> List(res))
+          case _ => None
+        }
+      }.toMap
+
