+#define PLAIN_DECODER_DEFINE_FIXED_SKIP(TYPE, NAME, READ_FUNC, BYTE_WIDTH)    \
+    int skip_##NAME(int count, int& skipped, common::ByteStream& in) override { \
+        skipped = 0;                                                           \
+        if (!in.is_wrapped()) {                                                \
+            TYPE dummy;                                                        \
+            while (skipped < count && in.has_remaining()) {                    \
+                int ret = common::SerializationUtil::READ_FUNC(dummy, in);     \
+                if (ret != common::E_OK) return ret;                           \
+                ++skipped;                                                     \
+            }                                                                  \
+            return common::E_OK;                                               \
+        }                                                                      \
+        skipped = static_cast<int>(std::min<uint32_t>(                         \
+            in.remaining_size() / BYTE_WIDTH, static_cast<uint32_t>(count)));  \
+        if (skipped <= 0) {                                                    \
+            skipped = 0;                                                       \
+            return common::E_OK;                                               \
+        }                                                                      \
+        in.wrapped_buf_advance_read_pos(static_cast<uint32_t>(skipped) *       \
+                                        BYTE_WIDTH);                           \
+        return common::E_OK;                                                   \
+    }
+
+#define PLAIN_DECODER_DEFINE_FIXED_BATCH(NAME, TYPE, READ_FUNC, WIRE_TYPE,     \
+                                         BSWAP_FUNC, BYTE_WIDTH,               \
+                                         STORE_SWAPPED)                        \
+    int read_batch_##NAME(TYPE* out, int capacity, int& actual,                \
+                          common::ByteStream& in) override {                   \
+        actual = 0;                                                            \
+        if (!in.is_wrapped()) {                                                \
+            while (actual < capacity && in.has_remaining()) {                  \
+                int ret = common::SerializationUtil::READ_FUNC(out[actual],    \
+                                                               in);            \
+                if (ret != common::E_OK) return ret;                           \
+                ++actual;                                                      \
+            }                                                                  \
+            return common::E_OK;                                               \
+        }                                                                      \
+        int n = static_cast<int>(std::min<uint32_t>(                           \
+            in.remaining_size() / BYTE_WIDTH,                                  \
+            static_cast<uint32_t>(capacity)));                                 \
+        if (n <= 0) return common::E_OK;                                       \
+                                                                               \
+        const uint8_t* src =                                                   \
+            (const uint8_t*)in.get_wrapped_buf() + in.read_pos();              \
+        in.wrapped_buf_advance_read_pos(static_cast<uint32_t>(n) *             \
+                                        BYTE_WIDTH);                           \
+        actual = n;                                                            \
+        for (int i = 0; i < n; ++i) {                                          \
+            WIRE_TYPE v;                                                       \
+            memcpy(&v, src + i * BYTE_WIDTH, BYTE_WIDTH);                      \
+            v = BSWAP_FUNC(v);                                                 \
+            STORE_SWAPPED;                                                     \
+        }                                                                      \
+        return common::E_OK;                                                   \
+    }
