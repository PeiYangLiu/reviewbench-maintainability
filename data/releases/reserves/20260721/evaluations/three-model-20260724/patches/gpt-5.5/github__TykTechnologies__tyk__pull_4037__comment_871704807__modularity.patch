+func (gw *Gateway) getAPIOASHandler(w http.ResponseWriter, r *http.Request) {
+	apiID := getAPIID(r)
+	scopePublic := isPublicOASRequest(r)
+
+	var obj interface{}
+	var code int
+
+	if apiID != "" {
