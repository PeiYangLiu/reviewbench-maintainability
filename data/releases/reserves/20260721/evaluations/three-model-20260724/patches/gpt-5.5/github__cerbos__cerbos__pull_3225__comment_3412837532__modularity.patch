+type jwtParseError struct {
+	friendly error
+	actual   error
+}
+
+func newJWTParseError(message string, actual error) error {
+	return &jwtParseError{
+		friendly: errors.New(message),
+		actual:   actual,
+	}
+}
+
+func (e *jwtParseError) Error() string {
+	return e.friendly.Error()
+}
+
+func (e *jwtParseError) Unwrap() error {
+	return e.actual
+}
+
+func (e *jwtParseError) FriendlyError() error {
+	return e.friendly
+}
+
+func (e *jwtParseError) ActualError() error {
+	return e.actual
+}
