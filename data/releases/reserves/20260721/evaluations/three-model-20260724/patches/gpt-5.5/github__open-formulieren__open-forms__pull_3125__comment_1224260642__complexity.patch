+class HaalCentraal20Client(BaseHaalCentraalClient):
+    attributes = AttributesV2
+
+    def fetch_person(self, bsn: str, attributes: Iterable[str]) -> Dict[str, Any]:
+        recource_body = {
+            "type": "RaadpleegMetBurgerservicenummer",
+            "burgerservicenummer": [bsn],
+            "fields": attributes,
+        }
+        return self.client.operation(
+            "Personen",
+            data=recource_body,
+            url="personen",
+            request_kwargs={
+                "headers": {"Content-Type": "application/json; charset=utf-8"}
+            },
+        )
+
+    def get_value(self, data: Dict[str, Any], attribute: str) -> Any:
+        return glom(data["personen"][0], attribute)
+
