+}
+
+
+def get_haalcentraal_client_class(config: HaalCentraalConfig):
+    try:
+        return _HAALCENTRAAL_CLIENTS[config.version]
+    except KeyError as exc:
+        raise InvalidPluginConfiguration(
+            _("Unsupported Haal Centraal version: {version}").format(
+                version=config.version
+            )
+        ) from exc
+
+
+def build_haalcentraal_client(
+    config: HaalCentraalConfig, submission: Optional[Submission]
+) -> BaseHaalCentraalClient:
+    client = config.service.build_client()
+    client.context = PreRequestClientContext(submission=submission)
+    return get_haalcentraal_client_class(config)(client)
