+func (c *connector) getKerberosClient(ctx context.Context, sessionCtx *common.Session) (*client.Client, error) {
+	if sessionCtx.Database.GetAD().KeytabFile != "" {
+		return keytabClient(sessionCtx)
+	}
+	if sessionCtx.Database.GetAD().KDCHostName != "" && sessionCtx.Database.GetAD().LDAPCert != "" {
+		return kinitClient(ctx, sessionCtx, c.AuthClient, c.DataDir)
+	}
+	return nil, fmt.Errorf("configuration must have either keytab or kdc_host_name and ldap_cert")
+}
