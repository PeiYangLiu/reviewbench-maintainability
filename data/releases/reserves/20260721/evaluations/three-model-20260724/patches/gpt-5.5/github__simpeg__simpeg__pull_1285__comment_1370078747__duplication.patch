+@jit(nopython=True)
+def _evaluate_kernel_on_nodes(receiver, nodes, kernels, kernel_func):
+    """
+    Evaluate a gravity kernel on every node for a single receiver.
+    """
+    for j in range(nodes.shape[0]):
+        dx = nodes[j, 0] - receiver[0]
+        dy = nodes[j, 1] - receiver[1]
+        dz = nodes[j, 2] - receiver[2]
+        distance = np.sqrt(dx**2 + dy**2 + dz**2)
+        kernels[j] = kernel_func(dx, dy, dz, distance)
+
+
+@jit(nopython=True)
+def _evaluate_kernel_on_cell(kernels, cell_nodes, cell_index):
+    """
+    Evaluate the prism node combination for a single cell.
+    """
+    return (
+        -kernels[cell_nodes[cell_index, 0]]
+        + kernels[cell_nodes[cell_index, 1]]
+        + kernels[cell_nodes[cell_index, 2]]
+        - kernels[cell_nodes[cell_index, 3]]
+        + kernels[cell_nodes[cell_index, 4]]
+        - kernels[cell_nodes[cell_index, 5]]
+        - kernels[cell_nodes[cell_index, 6]]
+        + kernels[cell_nodes[cell_index, 7]]
+    )
 
 
