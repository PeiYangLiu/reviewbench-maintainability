+
+func languageDataFromParseData(data parseDataJSON) languageData {
+	fileData := languageData{
+		ValidInput: true,
+	}
+
+	for _, t := range data.Tokens {
+		switch t.TokenType {
+		case identifier:
+			if identifier, ok := identifierFromToken(t); ok {
+				fileData.Identifiers = append(fileData.Identifiers, identifier)
+			}
+		case literal:
+			fileData.Literals = append(fileData.Literals, literalFromToken(t))
+		case comment:
+			fileData.Comments = append(fileData.Comments, commentFromToken(t))
+		default:
+			log.Warn(fmt.Sprintf("parseJS: unrecognised token type %s", t.TokenType))
+		}
+	}
+
+	for _, s := range data.Status {
+		status := statusFromParserStatus(s)
+		switch s.StatusType {
+		case parseInfo:
+			fileData.Info = append(fileData.Info, status)
+		case parseError:
+			fileData.Errors = append(fileData.Errors, status)
+			if strings.Contains(status.Message, fatalSyntaxErrorMarker) {
+				fileData.ValidInput = false
+			}
+		}
+	}
+
+	return fileData
+}
+
+func identifierFromToken(t parserTokenJSON) (parsedIdentifier, bool) {
+	symbolSubtype := token.CheckIdentifierType(t.TokenSubType)
+	if symbolSubtype == token.Other || symbolSubtype == token.Unknown {
+		return parsedIdentifier{}, false
+	}
+
+	return parsedIdentifier{
+		Type: symbolSubtype,
+		Name: t.Data.(string),
+		Pos:  t.Pos,
+	}, true
+}
+
+func literalFromToken(t parserTokenJSON) parsedLiteral[any] {
+	literal := parsedLiteral[any]{
+		Type:     t.TokenSubType,
+		GoType:   fmt.Sprintf("%T", t.Data),
+		Value:    t.Data,
+		RawValue: t.Extra["raw"].(string),
+		InArray:  t.Extra["array"] == true,
+		Pos:      t.Pos,
+	}
+
+	// check for BigInteger types which have to be represented as strings in JSON
+	if literal.Type == "Numeric" && literal.GoType == "string" {
+		if intAsString, ok := literal.Value.(string); ok {
+			var bigInt big.Int
+			if _, valid := bigInt.SetString(intAsString, 0); valid {
+				literal.Value = &bigInt
+				literal.GoType = fmt.Sprintf("%T", bigInt)
+			}
+		}
+	}
+
+	return literal
+}
+
+func commentFromToken(t parserTokenJSON) parsedComment {
+	return parsedComment{
+		Type: t.TokenSubType,
+		Data: t.Data.(string),
+		Pos:  t.Pos,
+	}
+}
+
+func statusFromParserStatus(s parserStatusJSON) parserStatus {
+	return parserStatus{
+		Type:    s.StatusType,
+		Name:    s.StatusSubType,
+		Message: s.Message,
+		Pos:     s.Pos,
+	}
 }
 
