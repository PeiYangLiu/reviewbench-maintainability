+
+type defaultScopedFlag struct {
+	name         string
+	value        *string
+	defaultValue string
+}
+
+func getDefaultScopedAuraFlags(cfg *clicfg.Config, organizationIdFlag, projectIdFlag string, organizationId, projectId *string) []defaultScopedFlag {
+	defaultSetting, err := cfg.Settings.Aura.GetDefault()
+	if err != nil {
+		log.Fatal(err)
+	}
+
+	return []defaultScopedFlag{
+		{
+			name:         organizationIdFlag,
+			value:        organizationId,
+			defaultValue: defaultSetting.OrganizationId,
+		},
+		{
+			name:         projectIdFlag,
+			value:        projectId,
+			defaultValue: defaultSetting.ProjectId,
+		},
+	}
+}
+
+func markDefaultScopedAuraFlagsRequired(cmd *cobra.Command, cfg *clicfg.Config, organizationIdFlag, projectIdFlag string, organizationId, projectId *string) error {
+	for _, flag := range getDefaultScopedAuraFlags(cfg, organizationIdFlag, projectIdFlag, organizationId, projectId) {
+		if flag.defaultValue != "" {
+			continue
+		}
+
+		err := cmd.MarkFlagRequired(flag.name)
+		if err != nil {
+			log.Fatal(err)
+		}
+	}
+
+	return nil
+}
+
+func updateDefaultScopedAuraFlagValues(cfg *clicfg.Config, organizationIdFlag, projectIdFlag string, organizationId, projectId *string) {
+	for _, flag := range getDefaultScopedAuraFlags(cfg, organizationIdFlag, projectIdFlag, organizationId, projectId) {
+		if *flag.value == "" {
+			*flag.value = flag.defaultValue
+		}
+	}
+}
 
