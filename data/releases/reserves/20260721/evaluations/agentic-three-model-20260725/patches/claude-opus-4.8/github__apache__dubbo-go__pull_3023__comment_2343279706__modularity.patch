+// isLogFileCurrent reports whether the log file was last modified today,
+// meaning it does not need to be rotated.
+func isLogFileCurrent(logFile *os.File) bool {
+	fileInfo, err := logFile.Stat()
+	if err != nil {
+		return false
+	}
+	now := time.Now().Format(FileDateFormat)
+	last := fileInfo.ModTime().Format(FileDateFormat)
+	return now == last
+}
