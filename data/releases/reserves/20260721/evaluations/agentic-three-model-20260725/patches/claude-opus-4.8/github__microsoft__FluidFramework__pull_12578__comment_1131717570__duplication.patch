+/**
+ * Combines two `overlapClients` red-black trees, returning the combined tree.
+ * If the destination tree is defined, it is modified in-place and returned; otherwise a clone of the
+ * source tree (if any) is returned.
+ *
+ * Combination is performed additively on `seglen` on a per-client basis.
+ */
+function combineOverlapClientTrees(
+	dest: RedBlackTree<number, IOverlapClient> | undefined,
+	src: RedBlackTree<number, IOverlapClient> | undefined,
+): RedBlackTree<number, IOverlapClient> | undefined {
+	if (!dest) {
+		return cloneOverlapRemoveClients(src);
+	}
+	if (src) {
+		src.map((srcProp: Property<number, IOverlapClient>) => {
+			const destProp = dest.get(srcProp.key);
+			if (destProp) {
+				destProp.data.seglen += srcProp.data.seglen;
+			} else {
+				dest.put(srcProp.data.clientId, { ...srcProp.data });
+			}
+			return true;
+		});
+	}
+	return dest;
+}
