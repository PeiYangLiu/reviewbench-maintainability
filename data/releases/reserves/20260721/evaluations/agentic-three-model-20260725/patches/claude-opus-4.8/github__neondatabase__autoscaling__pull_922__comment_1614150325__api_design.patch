+// GroupOption customizes a Group during construction with NewGroup.
+type GroupOption func(*group)
+
+// WithContext associates a Context with the Group.
+// The context will be canceled if any goroutine returns an error.
+// See https://pkg.go.dev/golang.org/x/sync/errgroup#WithContext
+func WithContext(ctx context.Context) GroupOption {
+	return func(g *group) {
+		g.ctx, g.cancel = context.WithCancel(ctx)
+	}
+}
+
+// WithPanicHandler sets a panic handler for the group.
+func WithPanicHandler(f func(any)) GroupOption {
+	return func(g *group) {
+		g.panicHandler = f
+	}
+}
