+function getDurationUnit(
+  series: Series[],
+  legend?: LineChartProps['legend']
+): number {
+  let durationUnit = 0;
+  const selectedSeries = series.filter(
+    ({seriesName}) => legend?.selected?.[seriesName] !== false
+  );
+
+  // Only calculate a range when there is more than one series to compare against
+  if (series[1] && selectedSeries.length) {
+    const max = Math.max(
+      ...selectedSeries[0].data.map(({value}) => value)
+    );
+    const min = Math.min(
+      ...selectedSeries[selectedSeries.length - 1].data
+        .map(({value}) => value)
+        .filter(value => !!value)
+    );
+    durationUnit = categorizeDuration((min + max) * 0.5);
+  }
+
+  return durationUnit;
+}
