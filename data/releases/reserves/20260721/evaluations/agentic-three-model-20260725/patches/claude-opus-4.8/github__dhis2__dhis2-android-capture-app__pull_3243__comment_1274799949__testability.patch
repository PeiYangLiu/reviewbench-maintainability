+data class EnrollmentIconData(
+    val programColor: Int,
+    val imageResource: Int,
+    val remainingEnrollments: Int? = null
+)
+
+fun List<Program>.getEnrollmentIconsData(
+    context: Context,
+    currentProgram: String?
+): List<EnrollmentIconData> {
+    val listSize = this.size
+    val iconsData = mutableListOf<EnrollmentIconData>()
+    var programCount = 0
+    run outer@{
+        filter { it.uid() != currentProgram }
+            .forEach inner@{ program ->
+                val color = ColorUtils.getColorFrom(
+                    program.style().color(),
+                    ColorUtils.getPrimaryColor(
+                        context,
+                        ColorUtils.ColorType.PRIMARY
+                    )
+                )
+                programCount++
+                if (programCount >= 4 && listSize > 4) {
+                    val otherEnrollmentsCount = getOtherEnrollmentsForTei(listSize)
+                    iconsData.add(
+                        EnrollmentIconData(
+                            programColor = color,
+                            imageResource = -1,
+                            remainingEnrollments = otherEnrollmentsCount
+                        )
+                    )
+                    return@outer
+                } else {
+                    val imageResource =
+                        ResourceManager(context)
+                            .getObjectStyleDrawableResource(
+                                program.style().icon(),
+                                R.drawable.ic_default_icon
+                            )
+                    iconsData.add(
+                        EnrollmentIconData(
+                            programColor = color,
+                            imageResource = imageResource
+                        )
+                    )
+                }
+            }
+    }
+    return iconsData
+}
