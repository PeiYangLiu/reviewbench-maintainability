+// DualPasswordOption is a PasswordOrLockOption restricted to the dual-password
+// action cases (RetainCurrentPassword / DiscardOldPassword). It reuses the
+// broader PasswordOrLockOption type because dual-password actions share the
+// same restore/parse machinery as account password-lock policy options; the
+// alias documents that only the dual-password action cases are expected here.
+type DualPasswordOption = PasswordOrLockOption
+
 // UserSpec is used for parsing create user statement.
 type UserSpec struct {
 	User               *auth.UserIdentity
 	AuthOpt            *AuthOption
-	DualPasswordOption *PasswordOrLockOption
