+// toIdentifier converts an identifier token into a parsedIdentifier. The
+// returned bool is false if the identifier is of a type that should be ignored.
+func (t parserTokenJSON) toIdentifier() (parsedIdentifier, bool) {
+	symbolSubtype := token.CheckIdentifierType(t.TokenSubType)
+	if symbolSubtype == token.Other || symbolSubtype == token.Unknown {
+		return parsedIdentifier{}, false
 	}
+	return parsedIdentifier{
+		Type: symbolSubtype,
+		Name: t.Data.(string),
+		Pos:  t.Pos,
+	}, true
+}
 
-	return processedOutput
+// toLiteral converts a literal token into a parsedLiteral.
+func (t parserTokenJSON) toLiteral() parsedLiteral[any] {
+	literal := parsedLiteral[any]{
+		Type:     t.TokenSubType,
+		GoType:   fmt.Sprintf("%T", t.Data),
+		Value:    t.Data,
+		RawValue: t.Extra["raw"].(string),
+		InArray:  t.Extra["array"] == true,
+		Pos:      t.Pos,
+	}
+	// check for BigInteger types which have to be represented as strings in JSON
+	if literal.Type == "Numeric" && literal.GoType == "string" {
+		if intAsString, ok := literal.Value.(string); ok {
+			var bigInt big.Int
+			if _, valid := bigInt.SetString(intAsString, 0); valid {
+				literal.Value = &bigInt
+				literal.GoType = fmt.Sprintf("%T", bigInt)
+			}
+		}
+	}
+	return literal
+}
+
+// toComment converts a comment token into a parsedComment.
+func (t parserTokenJSON) toComment() parsedComment {
+	return parsedComment{
+		Type: t.TokenSubType,
+		Data: t.Data.(string),
+		Pos:  t.Pos,
+	}
 }
 
