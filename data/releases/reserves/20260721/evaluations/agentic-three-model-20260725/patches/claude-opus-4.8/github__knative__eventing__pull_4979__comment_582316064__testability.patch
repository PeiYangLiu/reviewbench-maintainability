+// enqueueBrokerTriggers returns an event handler function that enqueues all the
+// Triggers belonging to the Broker passed in. It is extracted into a named
+// function so that the enqueue behavior can be unit tested independently of the
+// controller wiring.
+func enqueueBrokerTriggers(logger *zap.SugaredLogger, triggerLister v1.TriggerLister, impl *controller.Impl) func(obj interface{}) {
+	return func(obj interface{}) {
+		for _, t := range getBrokerTriggers(logger, triggerLister, obj) {
+			impl.Enqueue(t)
+		}
+	}
+}
+
