+// friendlyError wraps a user-friendly error message alongside the original
+// underlying error so that both can be accessed at the point of logging.
+type friendlyError struct {
+	friendly string
+	cause    error
+}
+
+func newFriendlyError(cause error, friendly string) *friendlyError {
+	return &friendlyError{friendly: friendly, cause: cause}
+}
+
+func (e *friendlyError) Error() string {
+	return e.friendly
+}
+
+func (e *friendlyError) Unwrap() error {
+	return e.cause
+}
