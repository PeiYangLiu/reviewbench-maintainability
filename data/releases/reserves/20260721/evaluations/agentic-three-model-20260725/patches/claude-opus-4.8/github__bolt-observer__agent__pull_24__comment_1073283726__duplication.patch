+// doAndDecode - executes the request, checks the status code and decodes the JSON body into out
+func (h *HTTPAPI) doAndDecode(req *http.Request, out interface{}) error {
+	resp, err := h.Do(req)
+
+	if err != nil {
+		return fmt.Errorf("http request failed %s", err)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("http got error %d", resp.StatusCode)
+	}
+
+	defer resp.Body.Close()
+
+	decoder := json.NewDecoder(resp.Body)
+
+	err = decoder.Decode(out)
+	if err != nil {
+		return fmt.Errorf("got error %v", err)
+	}
+
+	return nil
+}
