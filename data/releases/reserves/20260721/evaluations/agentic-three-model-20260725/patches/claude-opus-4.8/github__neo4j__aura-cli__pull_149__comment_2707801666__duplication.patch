+
+func markDefaultableFlagsRequired(cmd *cobra.Command, cfg *clicfg.Config, flags ...string) error {
+	defaultSetting, err := cfg.Settings.Aura.GetDefault()
+	if err != nil {
+		log.Fatal(err)
+	}
+
+	defaults := map[string]string{
+		"organization-id": defaultSetting.OrganizationId,
+		"project-id":      defaultSetting.ProjectId,
+	}
+
+	for _, flag := range flags {
+		if defaults[flag] == "" {
+			if err := cmd.MarkFlagRequired(flag); err != nil {
+				log.Fatal(err)
+			}
+		}
+	}
+
+	return nil
+}
