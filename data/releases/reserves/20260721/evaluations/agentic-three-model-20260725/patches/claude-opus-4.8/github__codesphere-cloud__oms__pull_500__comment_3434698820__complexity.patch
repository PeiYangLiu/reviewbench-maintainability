+// argoInstallState carries the shared state between the ArgoCD pre-step substeps.
+type argoInstallState struct {
+	opts        *InstallCodesphereOpts
+	ociPassword string
+	argoInstall *argocdinstaller.Installer
+	kubeClient  ctrlclient.Client
+	vault       *files.InstallVault
+	kubeConfig  *rest.Config
+}
+
+func (s *argoInstallState) loadVaultData() error {
+	var err error
+	s.vault, err = installer.LoadVaultData(s.opts.Vault, s.opts.PrivKey)
+	if err != nil {
+		return fmt.Errorf("failed to load vault: %w", err)
+	}
+	if secret := s.vault.GetSecret(files.SecretRegistryPassword); secret != nil && secret.Fields != nil {
+		s.ociPassword = secret.Fields.Password
+	}
+	if s.ociPassword == "" {
+		return fmt.Errorf("registry password not found in vault (secret %q)", files.SecretRegistryPassword)
+	}
+	kubeConfigContent, err := kubeConfigContentFromVault(s.vault)
+	if err != nil {
+		return err
+	}
+
+	s.kubeConfig, err = clientcmd.RESTConfigFromKubeConfig([]byte(kubeConfigContent))
+	if err != nil {
+		return fmt.Errorf("failed to load kubernetes config from vault: %w", err)
+	}
+	s.kubeClient, err = ctrlclient.New(s.kubeConfig, ctrlclient.Options{})
+	if err != nil {
+		return fmt.Errorf("failed to create kubernetes client: %w", err)
+	}
+	return nil
+}
+
+func (s *argoInstallState) installArgoCD() error {
+	cfg, err := installer.NewConfig().ParseConfigYaml(s.opts.Config)
+	if err != nil {
+		return fmt.Errorf("failed to parse config.yaml: %w", err)
+	}
+	ociRegistryURL := s.opts.ArgoCDRegistryURL
+	if ociRegistryURL == "" && cfg.Registry != nil {
+		ociRegistryURL = cfg.Registry.Server
+	}
+	s.argoInstall, err = argocdinstaller.NewInstaller(argocdinstaller.InstallerConfig{
+		Version:        s.opts.ArgoCDVersion,
+		DatacenterId:   fmt.Sprintf("%d", cfg.Datacenter.ID),
+		OciPassword:    s.ociPassword,
+		OciRegistryURL: ociRegistryURL,
+		GitPassword:    os.Getenv("OMS_GIT_PASSWORD"),
+		FullInstall:    true,
+		ForceConflicts: s.opts.ArgoCDForceConflicts,
+		RepoURL:        s.opts.ArgoCDRepoURL,
+		ValueFiles:     s.opts.ArgoCDValues,
+		RESTConfig:     s.kubeConfig,
+	})
+	if err != nil {
+		return fmt.Errorf("failed to initialize ArgoCD installer: %w", err)
+	}
+	if err := s.argoInstall.Install(); err != nil {
+		return fmt.Errorf("failed to install ArgoCD: %w", err)
+	}
+	return nil
+}
+
+func (s *argoInstallState) syncVaultSecret(ctx context.Context) error {
+	creator := installer.NewVaultSecretCreator(s.kubeClient)
+	if err := creator.CreateSecretFromVault(ctx, s.vault, installer.VaultSecretNamespace, installer.VaultSecretName); err != nil {
+		return fmt.Errorf("failed to sync vault secret: %w", err)
+	}
+	return nil
+}
+
+func (s *argoInstallState) installPcApps(ctx context.Context, pm installer.PackageManager) error {
+	pcApps, err := installer.NewPcAppsFromBom(s.kubeClient, pm.GetDependencyPath("bom.json"), argocdinstaller.DefaultNamespace)
+	if err != nil {
+		return fmt.Errorf("failed to initialize pc-apps installer: %w", err)
+	}
+	if err := pcApps.Install(ctx); err != nil {
+		return fmt.Errorf("failed to install pc-apps: %w", err)
+	}
+	return nil
+}
