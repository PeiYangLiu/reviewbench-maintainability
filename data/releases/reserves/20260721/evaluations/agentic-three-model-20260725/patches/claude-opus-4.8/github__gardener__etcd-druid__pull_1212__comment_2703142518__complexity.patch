+// resolveResourceMetas converts user-provided tokens (short names, plural/singular
+// resource names, or kinds) into resource metadata using the RESTMapper. The
+// RESTMapper implicitly handles all the naming variations, so no hardcoded
+// mapping is required.
+func resolveResourceMetas(mapper meta.RESTMapper, tokens []string) ([]resourceMeta, error) {
+	if len(tokens) == 0 {
+		return nil, fmt.Errorf("no resource tokens provided")
+	}
+
+	out := make([]resourceMeta, 0, len(tokens))
+	seen := map[schema.GroupVersionResource]struct{}{}
+	var unknown []string
+
+	for _, t := range tokens {
+		tok := strings.TrimSpace(strings.ToLower(t))
+		if tok == "" {
+			continue
+		}
+
+		m, err := resolveResourceMeta(mapper, tok)
+		if err != nil {
+			unknown = append(unknown, t)
+			continue
+		}
+
+		if _, dup := seen[m.GVR]; dup {
+			continue
+		}
+		seen[m.GVR] = struct{}{}
+		out = append(out, m)
+	}
+
+	if len(unknown) > 0 {
+		return nil, fmt.Errorf("unknown resource tokens: %v", unknown)
+	}
+
+	return out, nil
+}
+
+// resolveResourceMeta resolves a single token to resource metadata by letting the
+// RESTMapper resolve the resource and its kind/scope.
+func resolveResourceMeta(mapper meta.RESTMapper, token string) (resourceMeta, error) {
+	gvr, err := mapper.ResourceFor(schema.GroupVersionResource{Resource: token})
+	if err != nil {
+		return resourceMeta{}, err
+	}
+
+	gvk, err := mapper.KindFor(gvr)
+	if err != nil {
+		return resourceMeta{}, err
+	}
+
+	mapping, err := mapper.RESTMapping(gvk.GroupKind(), gvk.Version)
+	if err != nil {
+		return resourceMeta{}, err
+	}
+
+	return resourceMeta{
+		GVR:        mapping.Resource,
+		Kind:       mapping.GroupVersionKind.Kind,
+		Namespaced: mapping.Scope.Name() == meta.RESTScopeNameNamespace,
+	}, nil
+}
