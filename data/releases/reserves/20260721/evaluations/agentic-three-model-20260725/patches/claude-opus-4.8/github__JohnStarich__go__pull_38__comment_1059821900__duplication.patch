+// linkRewriter builds a replacer that rewrites godoc links to point at the
+// gopages base URL or the public pkg.go.dev site.
+func linkRewriter(defaultPackagePrefix, baseURL, modulePackage string) *strings.Replacer {
+	var (
+		defaultModulePrefix = defaultPackagePrefix + modulePackage
+		gopagesModulePrefix = fmt.Sprintf(`<a href="%s`, path.Join(baseURL, "/pkg", modulePackage))
+		publicDocPrefix     = `<a href="https://pkg.go.dev/`
+	)
+	return strings.NewReplacer(
+		defaultModulePrefix, gopagesModulePrefix, // module links -> /base/pkg/mypkg/foo
+		defaultPackagePrefix, publicDocPrefix, // other package links -> https://pkg.go.dev/bar
+	)
+}
