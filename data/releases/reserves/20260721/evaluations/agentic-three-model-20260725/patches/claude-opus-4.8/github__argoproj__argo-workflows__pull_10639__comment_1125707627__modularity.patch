+// collectDescendantNodes returns the given node and all of its descendants
+// by traversing the node's children breadth-first.
+func collectDescendantNodes(nodes wfv1.Nodes, root wfv1.NodeStatus) []wfv1.NodeStatus {
+	children := []wfv1.NodeStatus{}
+	q := []wfv1.NodeStatus{root}
+	for len(q) > 0 {
+		childNode := q[0]
+		q = q[1:]
+		for _, nodeID := range childNode.Children {
+			q = append(q, nodes[nodeID])
+		}
+		children = append(children, childNode)
+	}
+	return children
+}
