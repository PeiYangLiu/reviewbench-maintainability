+// setupDmverity ensures a dm-verity device exists and is verified for the given
+// source, returning the device path to mount and, when this call created the
+// device, its name so the caller can clean it up on a later error.
+func setupDmverity(ctx context.Context, source string, metadata *dmverity.DmverityMetadata) (devicePath, createdDevice string, _ error) {
+	log.G(ctx).WithField("source", source).Debug("detected dm-verity metadata, setting up dm-verity device")
+
+	supported, err := dmverity.IsSupported()
+	if err != nil || !supported {
+		return "", "", fmt.Errorf("layer requires dm-verity but system doesn't support it (dm_verity module not loaded): %w", err)
+	}
+
+	// Extract snapshot ID from source path
+	// Path format: {root}/snapshots/{id}/layer.erofs
+	snapshotID := filepath.Base(filepath.Dir(source))
+	deviceName := fmt.Sprintf("containerd-erofs-%s", snapshotID)
+	devicePath = dmverity.DevicePath(deviceName)
+
+	// Try to create dm-verity device first (avoids TOCTOU race)
+	log.G(ctx).WithFields(log.Fields{
+		"source":      source,
+		"device-name": deviceName,
+		"hash-offset": metadata.HashOffset,
+	}).Debug("opening dm-verity device")
+
+	if _, err := dmverity.Open(source, deviceName, source, metadata.RootHash, metadata.HashOffset, nil); err != nil {
+		// If Open failed because the device already exists, reuse it after verification.
+		if _, statErr := os.Stat(devicePath); statErr != nil {
+			return "", "", fmt.Errorf("failed to open dm-verity device: %w", err)
+		}
+		if verifyErr := dmverity.VerifyDevice(deviceName, metadata.RootHash); verifyErr != nil {
+			return "", "", fmt.Errorf("existing dm-verity device %q verification failed: %w", deviceName, verifyErr)
+		}
+		log.G(ctx).WithField("device", devicePath).Debug("dm-verity device already exists and verified, reusing")
+		return devicePath, "", nil
+	}
+
+	// Open succeeded, so this call owns the device and the caller must clean it up.
+	createdDevice = deviceName
+
+	// Wait for device to appear
+	for range 100 {
+		if _, err := os.Stat(devicePath); err == nil {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	// Verify device exists
+	if _, err := os.Stat(devicePath); err != nil {
+		return "", createdDevice, fmt.Errorf("dm-verity device %q not found after creation: %w", devicePath, err)
+	}
+
+	log.G(ctx).WithField("device", devicePath).Info("dm-verity device created successfully")
+	return devicePath, createdDevice, nil
+}
