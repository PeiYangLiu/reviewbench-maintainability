+def _translate_path(pat, sep):
+    """Translate a shell PATTERN to a regular expression body (without the
+    surrounding group), treating *sep* as a path separator.
+    """
+    SEP = re.escape(sep)
+    DOT = f'[^{SEP}]'
+    res = []
+    add = res.append
+    i, n = 0, len(pat)
+    while i < n:
+        c = pat[i]
+        i = i+1
+        if c == '*':
+            # compress consecutive `*` into one
+            h = i-1
+            while i < n and pat[i] == '*':
+                i = i+1
+            star_count = i-h
+            is_segment = (h == 0 or pat[h-1] == sep) and (i == n or pat[i] == sep)
+            if star_count == 1:
+                if is_segment:
+                    add(f'{DOT}+')
+                else:
+                    add(f'{DOT}*')
+            elif star_count == 2 and is_segment:
+                if i == n:
+                    add('.*')
+                else:
+                    add(f'(.*{SEP})?')
+                    i = i+1
+            else:
+                raise ValueError("Invalid pattern: '**' can only be an entire path component")
+        elif c == '?':
+            add(DOT)
+        elif c == '[':
+            piece, i = _translate_bracket(pat, i, n, DOT)
+            add(piece)
+        else:
+            add(re.escape(c))
+    assert i == n
+    return "".join(res)
