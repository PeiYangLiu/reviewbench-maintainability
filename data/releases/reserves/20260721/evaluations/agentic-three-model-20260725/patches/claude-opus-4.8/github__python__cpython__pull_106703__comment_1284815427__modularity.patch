+def _translate_bracket(pat, i, n, DOT):
+    """Translate a '[...]' character set starting at index *i* (just after the
+    opening '['). Returns the regular expression fragment and the index of the
+    first character after the set.
+    """
+    j = i
+    if j < n and pat[j] == '!':
+        j = j+1
+    if j < n and pat[j] == ']':
+        j = j+1
+    while j < n and pat[j] != ']':
+        j = j+1
+    if j >= n:
+        return '\\[', i
+    stuff = pat[i:j]
+    if '-' not in stuff:
+        stuff = stuff.replace('\\', r'\\')
+    else:
+        chunks = []
+        k = i+2 if pat[i] == '!' else i+1
+        while True:
+            k = pat.find('-', k, j)
+            if k < 0:
+                break
+            chunks.append(pat[i:k])
+            i = k+1
+            k = k+3
+        chunk = pat[i:j]
+        if chunk:
+            chunks.append(chunk)
+        else:
+            chunks[-1] += '-'
+        # Remove empty ranges -- invalid in RE.
+        for k in range(len(chunks)-1, 0, -1):
+            if chunks[k-1][-1] > chunks[k][0]:
+                chunks[k-1] = chunks[k-1][:-1] + chunks[k][1:]
+                del chunks[k]
+        # Escape backslashes and hyphens for set difference (--).
+        # Hyphens that create ranges shouldn't be escaped.
+        stuff = '-'.join(s.replace('\\', r'\\').replace('-', r'\-')
+                         for s in chunks)
+    # Escape set operations (&&, ~~ and ||).
+    stuff = re.sub(r'([&~|])', r'\\\1', stuff)
+    i = j+1
+    if not stuff:
+        # Empty range: never match.
+        return '(?!)', i
+    elif stuff == '!':
+        # Negated empty range: match any character.
+        return DOT, i
+    else:
+        if stuff[0] == '!':
+            stuff = '^' + stuff[1:]
+        elif stuff[0] in ('^', '['):
+            stuff = '\\' + stuff
+        return f'[{stuff}]', i
+
