+// extendLabelSetWithHashringConfig extends the given label set with a tenant's
+// external labels from the hashring configs. If one tenant appears in multiple
+// hashring configs, only the external label set from the first hashring config
+// is applied.
+func (t *MultiTSDB) extendLabelSetWithHashringConfig(lset labels.Labels, tenantID string) (labels.Labels, error) {
+	for _, hc := range t.hashringConfigs {
+		if !slices.Contains(hc.Tenants, tenantID) {
+			continue
+		}
+
+		lset, err := parseAndExtendSortedLabels(lset, hc.ExternalLabels, t.logger)
+		if err != nil {
+			return nil, errors.Wrap(err, "failed to parse external labels for tenant "+tenantID)
+		}
+		return lset, nil
+	}
+
+	return lset, nil
+}
+
 func (t *MultiTSDB) defaultTenantDataDir(tenantID string) string {
 	return path.Join(t.dataDir, tenantID)
 }
