+def _get_request_socket(request):
+    """Return the underlying socket for a request, or None if unavailable.
+
+    Depending on the WSGI server (waitress on Windows, gunicorn elsewhere) the
+    socket is exposed through a different environment key.
+    """
+    if platform.system().lower() == "windows":
+        channel = request.environ.get("waitress.channel", None)
+        return channel.socket if channel is not None else None
+    return request.environ.get("gunicorn.socket", None)
+
