+
+func resolveFlags(cmd *cobra.Command, cfg *clicfg.Config, orgIdFlag, projIdFlag string, orgId, projId *string) error {
+	defaultSetting, err := cfg.Settings.Aura.GetDefault()
+	if err != nil {
+		return err
+	}
+	if *orgId == "" {
+		if defaultSetting.OrganizationId == "" {
+			if err := cmd.MarkFlagRequired(orgIdFlag); err != nil {
+				return err
+			}
+		} else {
+			*orgId = defaultSetting.OrganizationId
+		}
+	}
+
+	if *projId == "" {
+		if defaultSetting.ProjectId == "" {
+			if err := cmd.MarkFlagRequired(projIdFlag); err != nil {
+				return err
+			}
+		} else {
+			*projId = defaultSetting.ProjectId
+		}
+	}
+
+	return nil
