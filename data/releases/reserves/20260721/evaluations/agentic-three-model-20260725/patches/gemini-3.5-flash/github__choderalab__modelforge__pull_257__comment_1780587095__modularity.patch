 import torch
+from typing import Tuple
 from loguru import logger as log
 from modelforge.potential.models import PairlistData
 from modelforge.dataset.dataset import NNPInputTuple
 
 
+def generate_indices(
+    n: int,
+    device: torch.device,
+    only_unique_pairs: bool = False,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """
+    Generate pairs of indices using a meshgrid.
+
+    Parameters
+    ----------
+    n : int
+        Number of particles.
+    device : torch.device
+        Device on which to allocate tensors.
+    only_unique_pairs : bool, optional
+        If True, only unique pairs (i < j) are returned.
+        If False, non-unique pairs excluding the diagonal (i != j) are returned.
+        By default False.
+
+    Returns
+    -------
+    Tuple[torch.Tensor, torch.Tensor]
+        A tuple containing the indices of the first and second atoms in each pair.
+    """
+    indices = torch.arange(n, device=device)
+    grid_x, grid_y = torch.meshgrid(indices, indices, indexing="ij")
+    if only_unique_pairs:
+        mask = grid_x < grid_y
+    else:
+        mask = grid_x != grid_y
+    return grid_x[mask], grid_y[mask]
+
