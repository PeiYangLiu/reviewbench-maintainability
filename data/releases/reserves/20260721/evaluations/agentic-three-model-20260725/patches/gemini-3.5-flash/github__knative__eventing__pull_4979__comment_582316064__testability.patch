+// enqueueTriggerOfBroker returns a function that enqueues Triggers associated with the given Broker.
+func enqueueTriggerOfBroker(logger *zap.SugaredLogger, triggerLister v1.TriggerLister, enqueue func(interface{})) func(interface{}) {
+	return func(obj interface{}) {
+		for _, t := range getBrokerTriggers(logger, triggerLister, obj) {
