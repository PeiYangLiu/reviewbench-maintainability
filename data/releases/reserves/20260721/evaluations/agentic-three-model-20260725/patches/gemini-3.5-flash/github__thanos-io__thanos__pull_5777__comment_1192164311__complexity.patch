+func (t *MultiTSDB) tenantExternalLabels(tenantID string, initialLset labels.Labels) (labels.Labels, error) {
+	for _, hc := range t.hashringConfigs {
+		for _, tenant := range hc.Tenants {
+			if tenant == tenantID {
+				lset, err := parseAndExtendSortedLabels(initialLset, hc.ExternalLabels, t.logger)
+				if err != nil {
