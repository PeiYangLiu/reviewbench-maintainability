+
+class HaalCentraal13Client(HaalCentraalClient):
+    def fetch_values(self, bsn: str, attributes: Iterable[str]) -> Dict[str, Any]:
+        headers = dict(headers={"Accept": "application/hal+json"})
+        data = self.client.retrieve(
+            "ingeschrevenpersonen",
+            burgerservicenummer=bsn,
+            url=f"ingeschrevenpersonen/{bsn}",
+            request_kwargs=headers,
+        )
+        values = dict()
+        for attr in attributes:
+            try:
+                values[attr] = glom(data, attr)
+            except GlomError:
+                logger.warning(
+                    f"missing expected attribute '{attr}' in backend response"
+                )
+        return values
+
+
+class HaalCentraal20Client(HaalCentraalClient):
+    def fetch_values(self, bsn: str, attributes: Iterable[str]) -> Dict[str, Any]:
+        headers = dict(
+            headers={"Content-Type": "application/json; charset=utf-8"}
+        )
+        recource_body = {
+            "type": "RaadpleegMetBurgerservicenummer",
+            "burgerservicenummer": [bsn],
+            "fields": attributes,
+        }
+        data = self.client.operation(
+            "Personen",
+            data=recource_body,
+            url="personen",
+            request_kwargs=headers,
+        )
+        values = dict()
+        for attr in attributes:
+            try:
+                values[attr] = glom(data["personen"][0], attr)
+            except GlomError:
+                logger.warning(
+                    f"missing expected attribute '{attr}' in backend response"
+                )
+        return values
+
+
+CLIENT_CLASSES = {
+    HaalCentraalVersion.haalcentraal13: HaalCentraal13Client,
+    HaalCentraalVersion.haalcentraal20: HaalCentraal20Client,
+}
 
 
