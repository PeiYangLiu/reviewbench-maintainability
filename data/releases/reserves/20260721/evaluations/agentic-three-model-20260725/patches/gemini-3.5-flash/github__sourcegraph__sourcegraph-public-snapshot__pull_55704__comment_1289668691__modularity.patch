+export function getAccountConnection(
+    serviceType: string,
+    external: NormalizedExternalAccount['external']
+): JSX.Element | string {
+    switch (serviceType) {
+        case 'openidconnect':
+        case 'saml':
+        case 'gerrit':
+            return external?.displayName || 'Not connected'
+        case 'azuredevops':
+            return (
+                <>
+                    {external?.displayName ? (
+                        <>
+                            {external.displayName} (@{external?.login})
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+        default:
+            return (
+                <>
+                    {external?.url ? (
+                        <>
+                            {external.displayName} (
+                            <Link to={external.url} target="_blank" rel="noopener noreferrer">
+                                @{external.login}
+                            </Link>
+                            )
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+    }
+}
