+func (s *SiteConfigurationChangeConnectionStore) computeNodesFirst(history []*database.SiteConfig) []*SiteConfigurationChangeResolver {
+	resolvers := make([]*SiteConfigurationChangeResolver, 0, len(history))
+	for i := 0; i < len(history)-1; i++ {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:                 s.db,
+			siteConfig:         history[i],
+			previousSiteConfig: history[i+1],
+		})
+	}
+	if len(history) > 0 {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:         s.db,
+			siteConfig: history[len(history)-1],
+		})
+	}
+	return resolvers
+}
+
+func (s *SiteConfigurationChangeConnectionStore) computeNodesLast(history []*database.SiteConfig) []*SiteConfigurationChangeResolver {
+	resolvers := make([]*SiteConfigurationChangeResolver, 0, len(history))
+	if len(history) > 0 {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:         s.db,
+			siteConfig: history[0],
+		})
+	}
+	for i := 1; i < len(history); i++ {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:                 s.db,
+			siteConfig:         history[i],
+			previousSiteConfig: history[i-1],
+		})
+	}
+	return resolvers
+}
