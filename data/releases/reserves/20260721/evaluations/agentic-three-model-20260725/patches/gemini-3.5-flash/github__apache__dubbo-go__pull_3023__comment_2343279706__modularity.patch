+// isCurrentDateFile checks if the log file's modification time matches the current date
+func isCurrentDateFile(logFile *os.File) bool {
+	now := time.Now().Format(FileDateFormat)
+	if fileInfo, err := logFile.Stat(); err == nil {
+		last := fileInfo.ModTime().Format(FileDateFormat)
+		return now == last
+	}
+	return false
+}
