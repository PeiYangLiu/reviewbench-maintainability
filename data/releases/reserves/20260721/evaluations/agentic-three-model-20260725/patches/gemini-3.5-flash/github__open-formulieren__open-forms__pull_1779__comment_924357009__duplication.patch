+def _extract_leaf_nodes(node) -> list:
+    if isinstance(node, list):
+        leaves = []
+        for item in node:
+            leaves.extend(_extract_leaf_nodes(item))
+        return leaves
+    if not isinstance(node, dict):
+        return []
+    if node.get("nodeType") == "leaf":
+        return [node]
+    leaves = []
+    for child in node.get("children", []):
+        leaves.extend(_extract_leaf_nodes(child))
+    return leaves
+
+
+@dataclass
+class IntrospectionResult:
+    _json_tree: Union[dict, list]
+
+    def as_string(self) -> str:
+        if isinstance(self._json_tree, list):
+            return ", ".join(stringify_json_tree(item) for item in self._json_tree)
+        return stringify_json_tree(self._json_tree)
+
+    @property
+    def input_components(self) -> list:
+        return _extract_leaf_nodes(self._json_tree)
+
+
