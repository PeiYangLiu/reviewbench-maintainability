+func severityTextToDataSetSeverity(sevText string, defaultSeverity int) int {
+	switch strings.ToLower(sevText) {
+	case "fine", "finest":
+		return 0
+	case "trace":
+		return 1
+	case "debug":
+		return 2
+	case "info", "information":
+		return 3
+	case "warn", "warning":
+		return 4
+	case "error":
+		return 5
+	case "fatal", "critical", "emergency":
+		return 6
+	default:
+		return defaultSeverity
+	}
+}
