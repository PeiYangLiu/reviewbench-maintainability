+data class EnrollmentIconData(val color: Int, val imageResource: Int)
+
+fun List<Program>.getEnrollmentIconsData(
+    context: Context,
+    currentProgram: String?
+): List<EnrollmentIconData> {
+    val listSize = this.size
+    var programCount = 0
+    val iconDatas = mutableListOf<EnrollmentIconData>()
+
+    val filteredPrograms = filter { it.uid() != currentProgram }
+    for (program in filteredPrograms) {
+        programCount++
+        if (programCount >= 4 && listSize > 4) {
+            break
+        } else {
+            val color = ColorUtils.getColorFrom(
+                program.style().color(),
+                ColorUtils.getPrimaryColor(
+                    context,
+                    ColorUtils.ColorType.PRIMARY
+                )
+            )
+            val imageResource =
+                ResourceManager(context)
+                    .getObjectStyleDrawableResource(
+                        program.style().icon(),
+                        R.drawable.ic_default_icon
+                    )
+            iconDatas.add(EnrollmentIconData(color, imageResource))
+        }
+    }
+
+    return iconDatas
+}
