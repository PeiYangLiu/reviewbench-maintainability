+func severityNumberToDatasetSeverity(sevNum plog.SeverityNumber, defaultSeverity int) int {
+	switch sevNum {
+	case 1, 2, 3, 4:
+		// TRACE
+		return 1
+	case 5, 6, 7, 8:
+		// DEBUG
+		return 2
+	case 9, 10, 11, 12:
+		// INFO
+		return 3
+	case 13, 14, 15, 16:
+		// WARN
+		return 4
+	case 17, 18, 19, 20:
+		// ERROR
+		return 5
+	case 21, 22, 23, 24:
+		// FATAL / CRITICAL / EMERGENCY
+		return 6
+	default:
+		return defaultSeverity
+	}
+}
+
+func severityTextToDatasetSeverity(sevText string, defaultSeverity int) int {
+	switch strings.ToLower(sevText) {
+	case "fine", "finest":
+		return 0
+	case "trace":
+		return 1
+	case "debug":
+		return 2
+	case "info", "information":
+		return 3
+	case "warn", "warning":
+		return 4
+	case "error":
+		return 5
+	case "fatal", "critical", "emergency":
+		return 6
+	default:
+		return defaultSeverity
+	}
+}
