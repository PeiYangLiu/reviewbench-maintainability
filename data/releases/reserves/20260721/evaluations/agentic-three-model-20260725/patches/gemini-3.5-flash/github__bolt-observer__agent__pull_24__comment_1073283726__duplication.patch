+// doRequest invokes HTTP request and handles error and status checking
+func (h *HTTPAPI) doRequest(req *http.Request) (*http.Response, error) {
+	resp, err := h.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("http request failed %s", err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		resp.Body.Close()
+		return nil, fmt.Errorf("http got error %d", resp.StatusCode)
+	}
+	return resp, nil
+}
