+func (m *ConsistentHashingMode) isCacheableHost(host string) bool {
+	for _, domain := range m.DomainsToCache {
+		if domain == host {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *ConsistentHashingMode) getSlice(start, end int64) (int64, error) {
+	if start/m.SliceSize != end/m.SliceSize {
+		return 0, fmt.Errorf("can't make a range request across a slice boundary: %d-%d straddles a slice boundary (slice size is %d)", start, end, m.SliceSize)
+	}
+	return start / m.SliceSize, nil
+}
+
+func (m *ConsistentHashingMode) hashKey(u *url.URL, slice int64, retry bool) (CacheKey, uint64, error) {
+	key := CacheKey{URL: u, Slice: slice, Retry: retry}
+	hashopts := &hashstructure.HashOptions{IgnoreZeroValue: true}
+	hash, err := hashstructure.Hash(key, hashstructure.FormatV2, hashopts)
+	if err != nil {
+		return key, 0, fmt.Errorf("error calculating hash of key: %w", err)
+	}
+	return key, hash, nil
+}
