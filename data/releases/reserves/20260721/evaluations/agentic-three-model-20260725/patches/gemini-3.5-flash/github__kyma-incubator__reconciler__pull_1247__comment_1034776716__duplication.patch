+// NeedsRestart checks if ingress-gateway needs to be restarted.
+func NeedsRestart(ctx context.Context, provider clientset.Provider, kubeConfig string) (bool, error) {
+	istioClient, err := provider.GetIstioClient(kubeConfig)
+	if err != nil {
+		return false, err
+	}
+
+	istioCRList, err := getIstioCR(ctx, istioClient)
+	if err != nil {
+		return false, err
+	}
+
+	if istioCRList != nil {
+		return ingressgateway.NeedsRestart(ctx, istioClient, istioCRList)
+	}
+
+	return false, nil
+}
