 object FunctionBuilder {
+  trait AsBlockType[T] {
+    def toBlockType(value: T, builder: FunctionBuilder): BlockType
+  }
+
+  object AsBlockType {
+    implicit val blockTypeInstance: AsBlockType[BlockType] = new AsBlockType[BlockType] {
+      def toBlockType(value: BlockType, builder: FunctionBuilder): BlockType = value
+    }
+
+    implicit val typeInstance: AsBlockType[Type] = new AsBlockType[Type] {
+      def toBlockType(value: Type, builder: FunctionBuilder): BlockType =
+        BlockType.ValueType(value)
+    }
+
+    implicit val functionTypeInstance: AsBlockType[FunctionType] = new AsBlockType[FunctionType] {
+      def toBlockType(value: FunctionType, builder: FunctionBuilder): BlockType =
+        builder.sigToBlockType(value)
+    }
+
+    implicit val resultTypesInstance: AsBlockType[List[Type]] = new AsBlockType[List[Type]] {
+      def toBlockType(value: List[Type], builder: FunctionBuilder): BlockType =
+        builder.sigToBlockType(FunctionType(Nil, value))
+    }
+  }
