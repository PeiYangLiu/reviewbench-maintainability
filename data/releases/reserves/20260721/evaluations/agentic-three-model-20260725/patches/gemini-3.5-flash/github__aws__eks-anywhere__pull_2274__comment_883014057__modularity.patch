+
+type tinkerbellInstaller struct {
+	*stack
+}
+
+func newTinkerbellInstaller(p *Provider, clusterSpec *cluster.Spec, ip string, createNamespace bool) *tinkerbellInstaller {
+	s := newStack(clusterSpec.VersionsBundle.Tinkerbell.TinkerbellStack, p.docker, p.writer, p.helm, ip).
+		withNamespace(constants.EksaSystemNamespace, createNamespace).
+		withHegel().
+		withTinkController().
+		withTinkServer()
+	return &tinkerbellInstaller{stack: s}
+}
+
+func (ti *tinkerbellInstaller) installOnBootstrap(ctx context.Context, kubeconfigFile string) error {
+	if err := ti.withoutBoots().install(ctx, kubeconfigFile); err != nil {
+		return err
+	}
+	return ti.installBootsOnDocker(ctx, kubeconfigFile)
+}
+
+func (ti *tinkerbellInstaller) installOnWorkload(ctx context.Context, kubeconfigFile string) error {
+	return ti.withBoots().install(ctx, kubeconfigFile)
+}
+
+func (ti *tinkerbellInstaller) uninstallLocalBoots(ctx context.Context) error {
+	return ti.docker.ForceRemove(ctx, boots)
+}
