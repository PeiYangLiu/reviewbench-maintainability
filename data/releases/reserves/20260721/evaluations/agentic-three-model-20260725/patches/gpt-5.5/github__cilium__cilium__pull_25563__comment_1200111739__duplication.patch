+type namespaceManager struct {
+	mu         sync.Mutex
+	namespaces map[string]*observerpb.Namespace
+}
+
+// NewNamespaceManager creates a namespace manager.
+func NewNamespaceManager() *namespaceManager {
+	return &namespaceManager{
+		namespaces: make(map[string]*observerpb.Namespace),
+	}
+}
+
+// AddNamespace adds ns to the namespace manager.
+func (m *namespaceManager) AddNamespace(ns *observerpb.Namespace) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	key := ns.GetCluster() + "/" + ns.GetNamespace()
+	m.namespaces[key] = ns
+}
+
+// GetNamespaces returns all namespaces sorted by cluster and namespace.
+func (m *namespaceManager) GetNamespaces() []*observerpb.Namespace {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	namespaces := make([]*observerpb.Namespace, 0, len(m.namespaces))
+	for _, ns := range m.namespaces {
+		namespaces = append(namespaces, ns)
+	}
+	slices.SortFunc(namespaces, func(a, b *observerpb.Namespace) bool {
+		if a.Cluster != b.Cluster {
+			return a.Cluster < b.Cluster
+		}
+		return a.Namespace < b.Namespace
+	})
+
+	return namespaces
+}
+
