+def _get_foreign_key_property_name_and_value(error_message: str) -> Tuple[str, str]:
+    property_name = re.search(r'Key \((.*?)\)', error_message).group(1).split(".")[0]
+    value = re.search(r'\)=\((.*?)\)', error_message).group(1)
+    return property_name, value
+
+
+def _get_foreign_key_referring_model(error_message: str) -> str:
+    return re.search(r'"([^"]*)"', error_message).group(1)
+
