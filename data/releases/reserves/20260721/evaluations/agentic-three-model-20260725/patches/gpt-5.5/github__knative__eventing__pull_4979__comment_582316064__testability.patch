+func newBrokerTriggerEventHandler(logger *zap.SugaredLogger, triggerLister v1.TriggerLister, enqueue func(interface{})) cache.ResourceEventHandler {
+	brokerFilter := pkgreconciler.AnnotationFilterFunc(brokerreconciler.ClassAnnotationKey, eventing.MTChannelBrokerClassValue, false /*allowUnset*/)
+	return cache.FilteringResourceEventHandler{
+		FilterFunc: brokerFilter,
+		Handler: controller.HandleAll(func(obj interface{}) {
+			for _, t := range getBrokerTriggers(logger, triggerLister, obj) {
+				enqueue(t)
+			}
+		}),
+	}
+}
