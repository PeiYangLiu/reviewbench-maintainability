+class ClientExtractor:
+    def __init__(self, repo_path_format, response_key, repo_filter=lambda repo: True):
+        self.repo_path_format = repo_path_format
+        self.response_key = response_key
+        self.repo_filter = repo_filter
+
+    def client_for_repo(self, repo_slug) -> Optional[CloudClient]:
+        path = self.repo_path_format.format(repo_slug=repo_slug)
+        url = f"{RAW_CONTENT_BASE_URL}/{path}/{REPO_METADATA_FILENAME}"
+        response = requests.get(url)
+        if response.status_code != requests.codes.ok:
+            return
+
+        return CloudClient(response.json())
+
+    def clients_from_response_json(self, response_json) -> List[CloudClient]:
+        return [
+            self.client_for_repo(repo[self.response_key])
+            for repo in response_json
+            if self.repo_filter(repo)
+        ]
+
