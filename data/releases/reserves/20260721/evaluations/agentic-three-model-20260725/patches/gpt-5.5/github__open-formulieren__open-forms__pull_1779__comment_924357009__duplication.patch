+@dataclass(frozen=True)
+class _JsonLogicIntrospectionResult:
+    json_tree: dict
+    input_components: list
+
+    def as_string(self):
+        return stringify_json_tree(self.json_tree)
+
+
+def _get_json_tree_input_components(node):
+    if node["nodeType"] == "leaf":
+        return [node]
+
+    return [
+        input_component
+        for child in node["children"]
+        for input_component in _get_json_tree_input_components(child)
+    ]
+
+
+def _introspect_json_logic(
+    expression, keys_mapped_to_component, keys_mapped_to_form, resulting_data
+):
+    logic_data = JsonLogicTest.from_expression(expression)
+    json_tree = convert_json_logic_in_json_tree(
+        logic_data,
+        keys_mapped_to_component,
+        keys_mapped_to_form,
+        resulting_data,
+    )
+
+    return _JsonLogicIntrospectionResult(
+        json_tree=json_tree,
+        input_components=_get_json_tree_input_components(json_tree),
+    )
+
