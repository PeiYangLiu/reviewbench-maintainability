+func (m *ConsistentHashingMode) cacheKeyHash(req *http.Request, start int64, end int64, retry bool) (CacheKey, uint64, error) {
+	if start/m.SliceSize != end/m.SliceSize {
+		return CacheKey{}, 0, fmt.Errorf("can't make a range request across a slice boundary: %d-%d straddles a slice boundary (slice size is %d)", start, end, m.SliceSize)
+	}
+	slice := start / m.SliceSize
+
+	key := CacheKey{URL: req.URL, Slice: slice, Retry: retry}
+	// we set IgnoreZeroValue so that we can add fields to the hash key
+	// later without breaking things.
+	// note that it's not safe to share a HashOptions so we create a fresh one each time.
+	hashopts := &hashstructure.HashOptions{IgnoreZeroValue: true}
+	hash, err := hashstructure.Hash(key, hashstructure.FormatV2, hashopts)
+	if err != nil {
+		return CacheKey{}, 0, fmt.Errorf("error calculating hash of key: %w", err)
+	}
+
+	return key, hash, nil
+}
+
+func consistentHashBucket(hash uint64, buckets int) int {
+	// jump is an implementation of Google's Jump Consistent Hash.
+	//
+	// See http://arxiv.org/abs/1406.2294 for details.
+	return int(jump.Hash(hash, buckets))
+}
