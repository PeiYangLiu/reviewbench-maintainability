+
+func asMSSQLConn(conn any) (*mssql.Conn, error) {
+	mssqlConn, ok := conn.(*mssql.Conn)
+	if !ok {
+		return nil, trace.BadParameter("expected *mssql.Conn, got: %T", conn)
+	}
+	return mssqlConn, nil
+}
