+func resolveResourceMappings(mapper meta.RESTMapper, tokens []string) ([]*meta.RESTMapping, error) {
+	if len(tokens) == 0 {
+		return nil, fmt.Errorf("no resource tokens provided")
+	}
+
+	resourceMappings := make([]*meta.RESTMapping, 0, len(tokens))
+	seen := map[schema.GroupVersionResource]struct{}{}
+	var unknown []string
+	for _, token := range tokens {
+		mapping, err := resolveResourceMapping(mapper, token)
+		if err != nil {
+			unknown = append(unknown, token)
+			continue
+		}
+		if _, ok := seen[mapping.Resource]; ok {
+			continue
+		}
+		seen[mapping.Resource] = struct{}{}
+		resourceMappings = append(resourceMappings, mapping)
+	}
+
+	if len(unknown) > 0 {
+		return nil, fmt.Errorf("unknown resource tokens: %v", unknown)
+	}
+
+	return resourceMappings, nil
+}
+
+func resolveResourceMapping(mapper meta.RESTMapper, token string) (*meta.RESTMapping, error) {
+	resource, err := mapper.ResourceFor(schema.GroupVersionResource{Resource: token})
+	if err == nil {
+		return restMappingForResource(mapper, resource)
+	}
+
+	kind, err := mapper.KindFor(schema.GroupVersionResource{Resource: token})
+	if err != nil {
+		return nil, err
+	}
+	return mapper.RESTMapping(kind.GroupKind(), kind.Version)
+}
+
+func restMappingForResource(mapper meta.RESTMapper, resource schema.GroupVersionResource) (*meta.RESTMapping, error) {
+	kind, err := mapper.KindFor(resource)
+	if err != nil {
+		return nil, err
+	}
+	return mapper.RESTMapping(kind.GroupKind(), kind.Version)
+}
