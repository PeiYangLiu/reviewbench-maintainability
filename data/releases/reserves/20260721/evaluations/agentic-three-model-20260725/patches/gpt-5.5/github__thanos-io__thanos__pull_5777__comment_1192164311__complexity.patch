+func (t *MultiTSDB) externalLabelsForTenant(tenantID string) ([]string, bool) {
+	for _, hc := range t.hashringConfigs {
+		if slices.Contains(hc.Tenants, tenantID) {
+			return hc.ExternalLabels, true
+		}
+	}
+	return nil, false
