+// isCurrentLogFile checks whether the log file was last modified today.
+func isCurrentLogFile(logFile *os.File) bool {
+	now := time.Now().Format(FileDateFormat)
+	fileInfo, err := logFile.Stat()
+	if err != nil {
+		return false
+	}
+	last := fileInfo.ModTime().Format(FileDateFormat)
+	return now == last
+}
