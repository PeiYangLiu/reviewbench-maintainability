+MALLOC_CHUNK_FIELD_RENAMES = {
+    "mchunk_size": "size",
+    "mchunk_prev_size": "prev_size",
+}
+
+
+def malloc_chunk_field_name(field_names, key):
+    """Return the malloc_chunk field name to use, accounting for glibc renames."""
+    field_names = set(field_names)
+    if key in field_names:
+        return key
+
+    for old_name, new_name in MALLOC_CHUNK_FIELD_RENAMES.items():
+        if key == old_name and new_name in field_names:
+            return new_name
+        if key == new_name and old_name in field_names:
+            return old_name
+
+    return key
+
