+func serversForGroup(addr string, group []*Config) ([]caddy.Server, error) {
+	servers := make([]caddy.Server, 0, group[0].NumSocks)
+	for range group[0].NumSocks {
+		s, ok, err := newServerForAddr(addr, group)
+		if err != nil {
+			return nil, err
+		}
+		if ok {
+			servers = append(servers, s)
+		}
+	}
+	return servers, nil
+}
+
+func newServerForAddr(addr string, group []*Config) (caddy.Server, bool, error) {
+	switch tr, _ := parse.Transport(addr); tr {
+	case transport.DNS:
+		s, err := NewServer(addr, group)
+		return s, true, err
+	case transport.TLS:
+		s, err := NewServerTLS(addr, group)
+		return s, true, err
+	case transport.QUIC:
+		s, err := NewServerQUIC(addr, group)
+		return s, true, err
+	case transport.GRPC:
+		s, err := NewServergRPC(addr, group)
+		return s, true, err
+	case transport.HTTPS:
+		s, err := NewServerHTTPS(addr, group)
+		return s, true, err
+	}
+	return nil, false, nil
+}
