+func parseNodeCIDR(address string) (net.IP, *net.IPNet) {
+	if address == "" {
+		return nil, nil
+	}
+	addr, ipNet, err := net.ParseCIDR(address)
+	if err != nil {
+		return nil, nil
+	}
+	return addr, ipNet
+}
+
+func (node *LocalNodeSpec) IPv4IPNet() *net.IPNet {
+	_, ipNet := parseNodeCIDR(node.IPv4Address)
+	return ipNet
+}
+
+func (node *LocalNodeSpec) IPv6IPNet() *net.IPNet {
+	_, ipNet := parseNodeCIDR(node.IPv6Address)
+	return ipNet
+}
+
+func (node *LocalNodeSpec) IPNets() (*net.IPNet, *net.IPNet) {
+	return node.IPv4IPNet(), node.IPv6IPNet()
+}
+
+func (node *LocalNodeSpec) IPv4IP() *net.IP {
+	addr, _ := parseNodeCIDR(node.IPv4Address)
+	if addr == nil {
+		return nil
+	}
+	return &addr
+}
+
+func (node *LocalNodeSpec) IPv6IP() *net.IP {
+	addr, _ := parseNodeCIDR(node.IPv6Address)
+	if addr == nil {
+		return nil
+	}
+	return &addr
+}
+
+func (node *LocalNodeSpec) IPs() (*net.IP, *net.IP) {
+	return node.IPv4IP(), node.IPv6IP()
+}
