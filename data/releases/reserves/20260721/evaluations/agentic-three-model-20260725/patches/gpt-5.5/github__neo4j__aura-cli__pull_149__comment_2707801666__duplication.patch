+func applyAuraDefaultFlags(cmd *cobra.Command, cfg *clicfg.Config, organizationIdFlag string, organizationId *string, projectIdFlag string, projectId *string, markRequiredFlags bool) {
+	defaultSetting, err := cfg.Settings.Aura.GetDefault()
+	if err != nil {
+		log.Fatal(err)
+	}
+
+	applyDefaultFlag := func(flag string, value *string, defaultValue string) {
+		if defaultValue == "" {
+			if markRequiredFlags {
+				err := cmd.MarkFlagRequired(flag)
+				if err != nil {
+					log.Fatal(err)
+				}
+			}
+			return
+		}
+
+		if !markRequiredFlags && *value == "" {
+			*value = defaultValue
+		}
+	}
+
+	applyDefaultFlag(organizationIdFlag, organizationId, defaultSetting.OrganizationId)
+	applyDefaultFlag(projectIdFlag, projectId, defaultSetting.ProjectId)
+}
