+func otelSeverityNumberToDataSetSeverity(sevNum plog.SeverityNumber, defaultSeverityLevel int) int {
+	// See https://opentelemetry.io/docs/specs/otel/logs/data-model/#field-severitynumber
+	// for OTEL mappings
+	switch sevNum {
+	case 1, 2, 3, 4:
+		// TRACE
+		return 1
+	case 5, 6, 7, 8:
+		// DEBUG
+		return 2
+	case 9, 10, 11, 12:
+		// INFO
+		return 3
+	case 13, 14, 15, 16:
+		// WARN
+		return 4
+	case 17, 18, 19, 20:
+		// ERROR
+		return 5
+	case 21, 22, 23, 24:
+		// FATAL / CRITICAL / EMERGENCY
+		return 6
+	default:
+		return defaultSeverityLevel
+	}
+}
