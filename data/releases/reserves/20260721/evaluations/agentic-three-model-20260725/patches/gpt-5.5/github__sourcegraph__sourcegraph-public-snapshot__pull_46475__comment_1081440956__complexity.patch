+func (s *SiteConfigurationChangeConnectionStore) siteConfigurationChangeResolversForFirst(history []*database.SiteConfig) []*SiteConfigurationChangeResolver {
+	resolvers := make([]*SiteConfigurationChangeResolver, 0, len(history))
+
+	// When paginating with First, history is in descending order: 5, 4, 3, 2, 1.
+	for i := 0; i < len(history)-1; i++ {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:                 s.db,
+			siteConfig:         history[i],
+			previousSiteConfig: history[i+1],
+		})
+	}
+
+	lastIndex := len(history) - 1
+	return append(resolvers, &SiteConfigurationChangeResolver{
+		db:         s.db,
+		siteConfig: history[lastIndex],
+	})
+}
+
+func (s *SiteConfigurationChangeConnectionStore) siteConfigurationChangeResolversForLast(history []*database.SiteConfig) []*SiteConfigurationChangeResolver {
+	resolvers := make([]*SiteConfigurationChangeResolver, 0, len(history))
+
+	// When paginating with Last, history is in ascending order: 1, 2, 3, 4, 5.
+	resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+		db:         s.db,
+		siteConfig: history[0],
+	})
+	for i := 1; i < len(history); i++ {
+		resolvers = append(resolvers, &SiteConfigurationChangeResolver{
+			db:                 s.db,
+			siteConfig:         history[i],
+			previousSiteConfig: history[i-1],
+		})
+	}
+
+	return resolvers
+}
