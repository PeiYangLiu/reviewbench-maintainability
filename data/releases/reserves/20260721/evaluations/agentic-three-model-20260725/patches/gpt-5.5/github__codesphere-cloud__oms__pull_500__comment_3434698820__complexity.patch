+type argoCDPrestep struct {
+	opts *InstallCodesphereOpts
+	pm   installer.PackageManager
+	ctx  context.Context
+
+	ociPassword string
+	kubeClient  ctrlclient.Client
+	vault       *files.InstallVault
+	kubeConfig  *rest.Config
+}
+
+func (p *argoCDPrestep) loadVaultData() error {
+	var err error
+	p.vault, err = installer.LoadVaultData(p.opts.Vault, p.opts.PrivKey)
+	if err != nil {
+		return fmt.Errorf("failed to load vault: %w", err)
+	}
+	if s := p.vault.GetSecret(files.SecretRegistryPassword); s != nil && s.Fields != nil {
+		p.ociPassword = s.Fields.Password
+	}
+	if p.ociPassword == "" {
+		return fmt.Errorf("registry password not found in vault (secret %q)", files.SecretRegistryPassword)
+	}
+	kubeConfigContent, err := kubeConfigContentFromVault(p.vault)
+	if err != nil {
 		return err
 	}
 
+	p.kubeConfig, err = clientcmd.RESTConfigFromKubeConfig([]byte(kubeConfigContent))
+	if err != nil {
+		return fmt.Errorf("failed to load kubernetes config from vault: %w", err)
+	}
+	p.kubeClient, err = ctrlclient.New(p.kubeConfig, ctrlclient.Options{})
+	if err != nil {
+		return fmt.Errorf("failed to create kubernetes client: %w", err)
+	}
+	return nil
+}
+
+func (p *argoCDPrestep) installArgoCD() error {
+	cfg, err := installer.NewConfig().ParseConfigYaml(p.opts.Config)
+	if err != nil {
+		return fmt.Errorf("failed to parse config.yaml: %w", err)
+	}
+	ociRegistryURL := p.opts.ArgoCDRegistryURL
+	if ociRegistryURL == "" && cfg.Registry != nil {
+		ociRegistryURL = cfg.Registry.Server
+	}
+	argoInstall, err := argocdinstaller.NewInstaller(argocdinstaller.InstallerConfig{
+		Version:        p.opts.ArgoCDVersion,
+		DatacenterId:   fmt.Sprintf("%d", cfg.Datacenter.ID),
+		OciPassword:    p.ociPassword,
+		OciRegistryURL: ociRegistryURL,
+		GitPassword:    os.Getenv("OMS_GIT_PASSWORD"),
+		FullInstall:    true,
+		ForceConflicts: p.opts.ArgoCDForceConflicts,
+		RepoURL:        p.opts.ArgoCDRepoURL,
+		ValueFiles:     p.opts.ArgoCDValues,
+		RESTConfig:     p.kubeConfig,
+	})
+	if err != nil {
+		return fmt.Errorf("failed to initialize ArgoCD installer: %w", err)
+	}
+	if err := argoInstall.Install(); err != nil {
+		return fmt.Errorf("failed to install ArgoCD: %w", err)
+	}
+	return nil
+}
+
+func (p *argoCDPrestep) syncVaultSecret() error {
+	creator := installer.NewVaultSecretCreator(p.kubeClient)
+	if err := creator.CreateSecretFromVault(p.ctx, p.vault, installer.VaultSecretNamespace, installer.VaultSecretName); err != nil {
+		return fmt.Errorf("failed to sync vault secret: %w", err)
+	}
+	return nil
+}
+
+func (p *argoCDPrestep) installPcApps() error {
+	pcApps, err := installer.NewPcAppsFromBom(p.kubeClient, p.pm.GetDependencyPath("bom.json"), argocdinstaller.DefaultNamespace)
+	if err != nil {
+		return fmt.Errorf("failed to initialize pc-apps installer: %w", err)
+	}
+	if err := pcApps.Install(p.ctx); err != nil {
+		return fmt.Errorf("failed to install pc-apps: %w", err)
+	}
 	return nil
 }
 
