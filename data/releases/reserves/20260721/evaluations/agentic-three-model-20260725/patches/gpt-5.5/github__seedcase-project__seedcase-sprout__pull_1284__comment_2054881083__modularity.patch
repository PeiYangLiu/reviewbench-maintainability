+def _is_matching_type(frictionless_type: FieldType, dtype: pl.DataType) -> bool:
+    """Check whether a Polars type is allowed for a Frictionless type.
+
+    Args:
+        frictionless_type: The Frictionless type to check against.
+        dtype: The Polars type.
+
+    Returns:
+        Whether the Polars type is an allowed representation of the Frictionless
+            type.
+    """
+    matching_types: dict[FieldType, bool] = {
+        "number": dtype.is_float() or dtype.is_decimal(),
+        "integer": dtype.is_integer() or isinstance(dtype, pl.Duration),
+        "string": isinstance(dtype, (pl.String, pl.Categorical, pl.Enum, pl.Binary)),
+        "date": isinstance(dtype, pl.Date),
+        "datetime": isinstance(dtype, pl.Datetime),
+        "time": dtype == pl.Time,  # Polars stores Time as a class
+        "boolean": isinstance(dtype, pl.Boolean),
+        "array": isinstance(dtype, (pl.String, pl.Array, pl.List)),
+        "object": isinstance(dtype, (pl.String, pl.Struct, pl.Object)),
+        "geopoint": (
+            isinstance(dtype, pl.Array) and dtype.size == 2 and dtype.inner.is_numeric()
+        ),
+        "geojson": isinstance(dtype, (pl.String, pl.Struct, pl.Object)),
+        "year": dtype.is_integer(),
+        "yearmonth": isinstance(dtype, pl.Date),
+        "duration": isinstance(dtype, pl.String),
+        "any": True,
+    }
+
+    return matching_types[frictionless_type]
+
+
