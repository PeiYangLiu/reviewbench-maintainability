+def _generate_pair_indices(indices: torch.Tensor, only_unique_pairs: bool):
+    """Generate pair indices from a meshgrid, optionally keeping only unique pairs."""
+    grid_i, grid_j = torch.meshgrid(indices, indices, indexing="ij")
+
+    if only_unique_pairs:
+        mask = grid_i < grid_j
+    else:
+        mask = grid_i != grid_j
+
+    return grid_i[mask], grid_j[mask]
+
+
+def _to_pairlist_data(
+    pair_indices: torch.Tensor,
+    d_ij: torch.Tensor,
+    r_ij: torch.Tensor,
+    in_cutoff: torch.Tensor,
+):
+    """Format filtered pair data as PairlistData."""
+    total_pairs = in_cutoff.sum()
+
+    pairs = torch.zeros(
+        2, total_pairs, dtype=torch.int64, device=pair_indices.device
+    )
+    pairs[0] = pair_indices[0][in_cutoff]
+    pairs[1] = pair_indices[1][in_cutoff]
+
+    return PairlistData(
+        pair_indices=pairs,
+        d_ij=d_ij[in_cutoff],
+        r_ij=r_ij[in_cutoff],
+    )
+
