+func identifierFromToken(t parserTokenJSON) (parsedIdentifier, bool) {
+	symbolSubtype := token.CheckIdentifierType(t.TokenSubType)
+	if symbolSubtype == token.Other || symbolSubtype == token.Unknown {
+		return parsedIdentifier{}, false
 	}
 
-	return processedOutput
+	return parsedIdentifier{
+		Type: symbolSubtype,
+		Name: t.Data.(string),
+		Pos:  t.Pos,
+	}, true
+}
+
+func literalFromToken(t parserTokenJSON) parsedLiteral[any] {
+	literal := parsedLiteral[any]{
+		Type:     t.TokenSubType,
+		GoType:   fmt.Sprintf("%T", t.Data),
+		Value:    t.Data,
+		RawValue: t.Extra["raw"].(string),
+		InArray:  t.Extra["array"] == true,
+		Pos:      t.Pos,
+	}
+
+	convertBigIntegerLiteral(&literal)
+
+	return literal
+}
+
+func convertBigIntegerLiteral(literal *parsedLiteral[any]) {
+	// BigInteger types have to be represented as strings in JSON.
+	if literal.Type != "Numeric" || literal.GoType != "string" {
+		return
+	}
+
+	intAsString, ok := literal.Value.(string)
+	if !ok {
+		return
+	}
+
+	var bigInt big.Int
+	if _, valid := bigInt.SetString(intAsString, 0); valid {
+		literal.Value = &bigInt
+		literal.GoType = fmt.Sprintf("%T", bigInt)
+	}
+}
+
+func commentFromToken(t parserTokenJSON) parsedComment {
+	return parsedComment{
+		Type: t.TokenSubType,
+		Data: t.Data.(string),
+		Pos:  t.Pos,
+	}
+}
+
+func (d *languageData) addStatus(s parserStatusJSON) {
+	status := statusFromJSON(s)
+	switch s.StatusType {
+	case parseInfo:
+		d.Info = append(d.Info, status)
+	case parseError:
+		d.Errors = append(d.Errors, status)
+		if strings.Contains(status.Message, fatalSyntaxErrorMarker) {
+			d.ValidInput = false
+		}
+	}
+}
+
+func statusFromJSON(s parserStatusJSON) parserStatus {
+	return parserStatus{
+		Type:    s.StatusType,
+		Name:    s.StatusSubType,
+		Message: s.Message,
+		Pos:     s.Pos,
+	}
 }
 
