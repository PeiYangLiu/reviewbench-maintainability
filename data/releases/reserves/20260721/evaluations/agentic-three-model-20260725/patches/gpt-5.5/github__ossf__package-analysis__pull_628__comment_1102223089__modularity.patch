+func (d parseDataJSON) processFile() languageData {
+	fileData := languageData{
+		ValidInput: true,
+	}
+
+	for _, t := range d.Tokens {
+		fileData.addToken(t)
+	}
+	for _, s := range d.Status {
+		fileData.addStatus(s)
+	}
+
+	return fileData
+}
+
+func (d *languageData) addToken(t parserTokenJSON) {
+	switch t.TokenType {
+	case identifier:
+		identifier, ok := identifierFromToken(t)
+		if ok {
+			d.Identifiers = append(d.Identifiers, identifier)
 		}
+	case literal:
+		d.Literals = append(d.Literals, literalFromToken(t))
+	case comment:
+		d.Comments = append(d.Comments, commentFromToken(t))
+	default:
+		log.Warn(fmt.Sprintf("parseJS: unrecognised token type %s", t.TokenType))
+	}
+}
 
