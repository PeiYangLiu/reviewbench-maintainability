+func (o *GetProposalOptions) Complete(args []string) error {
+	o.args = args
+
+	cfg, err := clientcmd.BuildConfigFromKubeconfigGetter("", common.InKubeGetter)
+	if err != nil {
+		return err
+	}
+	cli, err := dynamic.NewForConfig(cfg)
+	if err != nil {
+		return err
+	}
+	o.cli = cli
+
+	return nil
+}
+
+func (o *GetProposalOptions) Run() error {
+	list := corev1.List{
+		TypeMeta: v1.TypeMeta{
+			Kind:       "List",
+			APIVersion: "v1",
+		},
+		ListMeta: v1.ListMeta{},
+	}
+	var obj runtime.Object
+	if len(o.args) == 0 {
+		username := viper.GetString("auth.username")
+		organizations, err := getOrganizationsByAdmin(context.TODO(), o.cli, username)
+		if err != nil {
+			return err
+		}
+		var proposalNames []string
+		for _, org := range organizations.Items {
+			namespace := org.GetName()
+			votes, err := o.cli.Resource(schema.GroupVersionResource{Group: common.IBPGroup, Version: common.IBPVersion, Resource: common.Vote}).Namespace(namespace).List(context.TODO(), v1.ListOptions{})
+			if err != nil {
+				fmt.Fprintln(o.ErrOut, err)
+				continue
+			}
+			for _, vote := range votes.Items {
+				proposalName := utils.GetNestedString(vote.Object, "spec", "proposalName")
+				proposalNames = append(proposalNames, proposalName)
+			}
+		}
+		for _, proposalName := range utils.RemoveDuplicateForStringSlice(proposalNames) {
+			proposal, err := o.cli.Resource(schema.GroupVersionResource{Group: common.IBPGroup, Version: common.IBPVersion, Resource: common.Proposal}).Get(context.TODO(), proposalName, v1.GetOptions{})
+			if err != nil {
+				fmt.Fprintln(o.ErrOut, err)
+				continue
+			}
+			list.Items = append(list.Items, runtime.RawExtension{Object: proposal})
+		}
+	} else {
+		for _, arg := range o.args {
+			proposal, err := o.cli.Resource(schema.GroupVersionResource{Group: common.IBPGroup, Version: common.IBPVersion, Resource: common.Proposal}).Get(context.TODO(), arg, v1.GetOptions{})
+			if err != nil {
+				fmt.Fprintln(o.ErrOut, err)
+				continue
+			}
+			list.Items = append(list.Items, runtime.RawExtension{Object: proposal})
+		}
+	}
+
+	if len(list.Items) != 1 {
+		listData, err := json.Marshal(list)
+		if err != nil {
+			return err
+		}
+		converted, err := runtime.Decode(unstructured.UnstructuredJSONScheme, listData)
+		if err != nil {
+			return err
+		}
+		obj = converted
+	} else {
+		obj = list.Items[0].Object
+	}
+
+	p, err := o.PrintFlags.ToPrinter()
+	if err != nil {
+		return err
+	}
+	return p.PrintObj(obj, o.Out)
+}
