+func convertInput(
+	index int,
+	status CompletionStatus,
+	msgSender string,
+	timestampStr string,
+	blockNumberStr string,
+	payloadStr string,
+) (*Input, error) {
+	timestamp, err := strconv.ParseUint(timestampStr, 0, 64)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse timestamp: %v", err)
+	}
+
+	blocknumber, err := strconv.ParseUint(blockNumberStr, 0, 64)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse block number: %v", err)
+	}
+	payload, err := hexutil.Decode(payloadStr)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode payload to bytes: %v", err)
+	}
+
+	return &Input{
+		Index:       index,
+		Status:      status,
+		MsgSender:   common.HexToAddress(msgSender),
+		Timestamp:   time.Duration(timestamp),
+		BlockNumber: blocknumber,
+		Payload:     payload,
+	}, nil
+}
