+// Option customizes the behavior of a Group created by NewGroup.
+type Option func(*group)
+
+// WithContext associates the Group with a Context.
+// The context will be canceled if any goroutine returns an error.
+// See https://pkg.go.dev/golang.org/x/sync/errgroup#WithContext
+func WithContext(ctx context.Context) Option {
+	return func(g *group) {
+		g.ctx, g.cancel = context.WithCancel(ctx)
+	}
+}
+
+// WithPanicHandler sets a panic handler for the group.
+func WithPanicHandler(f func(any)) Option {
+	return func(g *group) {
+		g.panicHandler = f
+	}
+}
