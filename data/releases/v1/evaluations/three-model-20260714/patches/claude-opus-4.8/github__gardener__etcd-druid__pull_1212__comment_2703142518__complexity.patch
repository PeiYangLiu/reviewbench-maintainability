+
+// resourceMeta captures the resolved metadata for a requested resource token.
+type resourceMeta struct {
+	GVR        schema.GroupVersionResource
+	Kind       string
+	Namespaced bool
+}
+
+// resolveResources resolves the provided resource tokens (short names, plural,
+// kind, etc.) into their fully qualified metadata using the RESTMapper, which
+// implicitly handles all naming variations.
+func resolveResources(mapper meta.RESTMapper, tokens []string) ([]resourceMeta, error) {
+	metas := make([]resourceMeta, 0, len(tokens))
+	seen := map[schema.GroupVersionResource]struct{}{}
+	for _, token := range tokens {
+		gvr, err := mapper.ResourceFor(schema.GroupVersionResource{Resource: token})
+		if err != nil {
+			return nil, fmt.Errorf("unable to resolve resource %q: %w", token, err)
+		}
+		if _, ok := seen[gvr]; ok {
+			continue
+		}
+		seen[gvr] = struct{}{}
+		gvk, err := mapper.KindFor(gvr)
+		if err != nil {
+			return nil, fmt.Errorf("unable to resolve kind for resource %q: %w", token, err)
+		}
+		mapping, err := mapper.RESTMapping(gvk.GroupKind(), gvk.Version)
+		if err != nil {
+			return nil, fmt.Errorf("unable to resolve mapping for resource %q: %w", token, err)
+		}
+		metas = append(metas, resourceMeta{
+			GVR:        gvr,
+			Kind:       gvk.Kind,
+			Namespaced: mapping.Scope.Name() == meta.RESTScopeNameNamespace,
+		})
+	}
+	return metas, nil
+}
 
