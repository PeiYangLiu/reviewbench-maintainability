+    def _get_var_attr(self, attr, vars_to_load, solution_number=0):
+        """Return a ComponentMap of {pyomo var: attr value} for the requested vars.
+
+        If ``vars_to_load`` is None, values for all variables are returned.  For
+        ``solution_number != 0``, the requested (suboptimal) solution is
+        temporarily selected while the values are read.
+        """
+        if solution_number != 0:
+            if (
+                self._solver_model.getAttr('NumIntVars') == 0
+                and self._solver_model.getAttr('NumBinVars') == 0
+            ):
+                raise ValueError(
+                    'Cannot obtain suboptimal solutions for a continuous model'
+                )
+            original_solution_number = self._solver_model.getParamInfo(
+                'SolutionNumber'
+            )[2]
+            self._solver_model.setParam('SolutionNumber', solution_number)
+        try:
+            var_map = self._get_var_map()
+            if vars_to_load is None:
+                vars_to_load = list(var_map.keys())
+            gvars = [var_map[v] for v in vars_to_load]
+            vals = self._solver_model.getAttr(attr, gvars)
+            return ComponentMap(zip(vars_to_load, vals))
+        finally:
+            if solution_number != 0:
+                self._solver_model.setParam(
+                    'SolutionNumber', original_solution_number
+                )
 
