+// newInput converts the fields returned by genqlient into an Input.
+func newInput(
+	index int,
+	status CompletionStatus,
+	msgSender string,
+	rawTimestamp string,
+	rawBlockNumber string,
+	rawPayload string,
+) (*Input, error) {
+	timestamp, err := strconv.ParseUint(rawTimestamp, 0, 64)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse timestamp: %v", err)
+	}
+
+	blocknumber, err := strconv.ParseUint(rawBlockNumber, 0, 64)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse block number: %v", err)
+	}
+
+	payload, err := hexutil.Decode(rawPayload)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode payload to bytes: %v", err)
+	}
+
+	return &Input{
+		index,
+		status,
+		common.HexToAddress(msgSender),
+		time.Duration(timestamp),
+		blocknumber,
+		payload,
+	}, nil
+}
