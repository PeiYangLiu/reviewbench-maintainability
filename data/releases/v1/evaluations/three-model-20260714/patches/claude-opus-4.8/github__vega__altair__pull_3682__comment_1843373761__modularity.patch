@@ -25,6 +25,27 @@
 
     from vegafusion.runtime import ChartState
 
+
+def _is_supported_by_vegafusion_v2(data: DataType) -> bool:
+    # VegaFusion v2 supports narwhals-compatible DataFrames
+    return isinstance(data, DataFrameLike) or isinstance(
+        nw.from_native(data, pass_through=True), (nw.DataFrame, nw.LazyFrame)
+    )
+
+
+def _is_supported_by_vegafusion_v1(data: DataType) -> bool:
+    return isinstance(data, DataFrameLike)
+
+
+# Select the appropriate support check once, based on the installed
+# VegaFusion version, rather than re-checking the version on every call.
+if (_vegafusion_version := importlib_version("vegafusion")) and Version(
+    _vegafusion_version
+) >= Version("2.0.0a0"):
+    _is_supported_by_vegafusion = _is_supported_by_vegafusion_v2
+else:
+    _is_supported_by_vegafusion = _is_supported_by_vegafusion_v1
+
