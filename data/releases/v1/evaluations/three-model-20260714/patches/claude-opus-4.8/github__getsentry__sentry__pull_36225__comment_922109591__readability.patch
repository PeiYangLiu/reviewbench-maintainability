+function computeYAxisSelectionRange(
+  series: Series[],
+  legend: Props['legend']
+): {max: number; min: number} | undefined {
+  if (!series[1]) {
+    return undefined;
+  }
+
+  let minSeries = series[0];
+  let maxSeries;
+  series.forEach((currentSeries, idx) => {
+    if (legend?.selected?.[currentSeries.seriesName] !== false) {
+      minSeries = series[idx];
+      maxSeries ??= series[idx];
+    }
+  });
+
+  const max = Math.max(...maxSeries?.data.map(({value}) => value));
+  const min = Math.min(
+    ...minSeries?.data.map(({value}) => value).filter(value => !!value)
+  );
+
+  return {max, min};
+}
 
