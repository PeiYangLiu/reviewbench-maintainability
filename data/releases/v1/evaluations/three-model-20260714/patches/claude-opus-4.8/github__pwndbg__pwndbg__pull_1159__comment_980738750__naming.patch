+# Some fields of the malloc_chunk struct were renamed in newer glibc versions.
+# Map the canonical name we use throughout pwndbg to the possible struct field
+# names, preferring the newer one when present.
+_MALLOC_CHUNK_FIELD_RENAMES = {
+    "prev_size": "mchunk_prev_size",
+    "size": "mchunk_size",
+}
+
+
+def resolve_renamed_field(gdb_value, name):
+    """Return the actual field name for `name` in `gdb_value`, accounting for
+    fields that were renamed across glibc versions."""
+    renamed = _MALLOC_CHUNK_FIELD_RENAMES.get(name)
+    if renamed is not None and renamed in (field.name for field in gdb_value.type.fields()):
+        return renamed
+    return name
+
