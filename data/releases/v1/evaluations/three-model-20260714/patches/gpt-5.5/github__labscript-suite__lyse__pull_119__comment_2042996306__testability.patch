+class _AnalysisContext:
+    """Runtime state shared with lyse GUI analysis worker subprocesses.
+
+    The GUI overwrites this state so that analysis scripts can run unchanged
+    from the command line or from within lyse. The module-level names below are
+    retained for backwards compatibility with existing scripts and worker code.
+    """
+
+    def __init__(self):
+        # True when running under the lyse GUI analysis worker.
+        self.spinning_top = False
+        # Data to be sent back to the lyse GUI if running within lyse.
+        self._updated_data = {}
+        # Dictionary of plot id's to classes to use for Plot object.
+        self._plot_classes = {}
+        # A fake Plot object to subclass if we are not running in the GUI.
+        self.Plot = object
+        # Plots managed by the analysis worker if running within lyse.
+        self.plots = {}
+        # A threading.Event to delay returning results to the GUI.
+        self.delay_event = threading.Event()
+        # A flag to determine whether we should wait for the delay event.
+        self._delay_flag = False
+        # Path of the hdf5 file being analysed when run from the command line.
+        self.path = sys.argv[1] if len(sys.argv) > 1 else None
+
+
+_analysis_context = _AnalysisContext()
+_CONTEXT_GLOBALS = frozenset(vars(_analysis_context))
+globals().update(
+    {name: getattr(_analysis_context, name) for name in _CONTEXT_GLOBALS}
+)
+
+
+class _LyseModule(types.ModuleType):
+    def __setattr__(self, name, value):
+        if name in _CONTEXT_GLOBALS:
+            setattr(_analysis_context, name, value)
+        super().__setattr__(name, value)
+
+
+sys.modules[__name__].__class__ = _LyseModule
+
+
+def _record_updated_result(h5_path, group, name, value):
+    """Record a saved result for the lyse GUI dataframe update response."""
+    if not _analysis_context.spinning_top:
+        return
+    updated_data = _analysis_context._updated_data
+    if h5_path not in updated_data:
+        updated_data[h5_path] = {}
+    if group.startswith('results'):
+        toplevel = group.replace('results/', '', 1)
+        updated_data[h5_path][toplevel, name] = value
 
 
