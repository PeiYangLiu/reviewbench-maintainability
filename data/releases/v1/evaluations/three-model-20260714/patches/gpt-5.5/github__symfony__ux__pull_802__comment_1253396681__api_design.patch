 use Twig\Environment;
+use Twig\Loader\LoaderInterface;
+
+interface ComponentTemplateFinderInterface
+{
+    public function findAnonymousComponentTemplate(string $name): ?string;
+}
+
+final class TwigComponentTemplateFinder implements ComponentTemplateFinderInterface
+{
+    public function __construct(private LoaderInterface $loader)
+    {
+    }
+
+    public function findAnonymousComponentTemplate(string $name): ?string
+    {
+        $componentPath = rtrim(str_replace(':', '/', $name));
+
+        if ($this->loader->exists($componentPath)) {
+            return $componentPath;
+        }
+
+        if ($this->loader->exists($componentPath.'.html.twig')) {
+            return $componentPath.'.html.twig';
+        }
+
+        if ($this->loader->exists('components/'.$componentPath)) {
+            return 'components/'.$componentPath;
+        }
+
+        if ($this->loader->exists('/components/'.$componentPath.'.html.twig')) {
+            return '/components/'.$componentPath.'.html.twig';
+        }
+
+        return null;
+    }
+}
 
