+def resolve_malloc_chunk_field_renames(field_names, field_name=None):
+    field_names = list(field_names)
+
+    if field_name is None:
+        return [MALLOC_CHUNK_FIELD_RENAMES.get(name, name) for name in field_names]
+
+    if field_name in field_names:
+        return field_name
+
+    for old_name, new_name in MALLOC_CHUNK_FIELD_RENAMES.items():
+        if field_name == old_name and new_name in field_names:
+            return new_name
+        if field_name == new_name and old_name in field_names:
+            return old_name
+
+    return MALLOC_CHUNK_FIELD_RENAMES.get(field_name, field_name)
+
 
