+                    {account.external?.displayName ? (
+                        <>
+                            {account.external.displayName} (@{account.external?.login})
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+        default:
+            return (
+                <>
+                    {account.external?.url ? (
+                        <>
+                            {account.external.displayName} (
+                            <Link to={account.external.url} target="_blank" rel="noopener noreferrer">
+                                @{account.external.login}
+                            </Link>
+                            )
+                        </>
+                    ) : (
+                        'Not connected'
+                    )}
+                </>
+            )
+    }
