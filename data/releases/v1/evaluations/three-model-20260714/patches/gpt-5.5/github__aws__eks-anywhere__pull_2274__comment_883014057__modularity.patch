+
+type tinkerbellStackInstaller interface {
+	Install(ctx context.Context, kubeconfigFile string) error
+}
+
+type tinkerbellStackInstallerFunc func(ctx context.Context, kubeconfigFile string) error
+
+func (i tinkerbellStackInstallerFunc) Install(ctx context.Context, kubeconfigFile string) error {
+	return i(ctx, kubeconfigFile)
+}
+
+type tinkerbellStackInstallerConfig struct {
+	createNamespace       bool
+	installBootsOnCluster bool
+	installBootsOnDocker  bool
+	removeLocalBoots      bool
+	installErrMsg         string
+}
+
+type tinkerbellStackInstallerOption func(*tinkerbellStackInstallerConfig)
+
+func withBootsOnDocker() tinkerbellStackInstallerOption {
+	return func(config *tinkerbellStackInstallerConfig) {
+		config.installBootsOnCluster = false
+		config.installBootsOnDocker = true
+	}
+}
+
+func withoutTinkerbellNamespaceCreation() tinkerbellStackInstallerOption {
+	return func(config *tinkerbellStackInstallerConfig) {
+		config.createNamespace = false
+	}
+}
+
+func withLocalBootsCleanup() tinkerbellStackInstallerOption {
+	return func(config *tinkerbellStackInstallerConfig) {
+		config.removeLocalBoots = true
+	}
+}
+
+func withTinkerbellStackInstallError(message string) tinkerbellStackInstallerOption {
+	return func(config *tinkerbellStackInstallerConfig) {
+		config.installErrMsg = message
+	}
+}
+
+func (p *Provider) newDefaultTinkerbellStackInstaller(clusterSpec *cluster.Spec, ip string, opts ...tinkerbellStackInstallerOption) tinkerbellStackInstaller {
+	config := &tinkerbellStackInstallerConfig{
+		createNamespace:       true,
+		installBootsOnCluster: true,
+		installErrMsg:         "install Tinkerbell stack: %v",
+	}
+
+	for _, opt := range opts {
+		opt(config)
+	}
+
+	return tinkerbellStackInstallerFunc(func(ctx context.Context, kubeconfigFile string) error {
+		stack := newStack(clusterSpec.VersionsBundle.Tinkerbell.TinkerbellStack, p.docker, p.writer, p.helm, ip).
+			withNamespace(constants.EksaSystemNamespace, config.createNamespace)
+
+		if config.installBootsOnCluster {
+			stack = stack.withBoots()
+		} else {
+			stack = stack.withoutBoots()
+		}
+
+		stack = stack.
+			withHegel().
+			withTinkController().
+			withTinkServer()
+
+		if err := stack.install(ctx, kubeconfigFile); err != nil {
+			return fmt.Errorf(config.installErrMsg, err)
+		}
+
+		if config.installBootsOnDocker {
+			if err := stack.installBootsOnDocker(ctx, kubeconfigFile); err != nil {
+				return err
+			}
+		}
+
+		if config.removeLocalBoots {
+			logger.V(4).Info("Removing local boots container")
+			if err := p.docker.ForceRemove(ctx, boots); err != nil {
+				return fmt.Errorf("remove local boots container: %v", err)
+			}
+		}
+
+		return nil
+	})
 }
 
