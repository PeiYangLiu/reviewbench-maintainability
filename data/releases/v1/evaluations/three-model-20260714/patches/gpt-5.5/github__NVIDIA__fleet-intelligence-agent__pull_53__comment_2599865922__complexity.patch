+
+func populateProviderPrivateIP(providerInfo *machineinfo.ProviderInfo, machineInfo *machineinfo.MachineInfo) {
+	if providerInfo.PrivateIP != "" || machineInfo == nil || machineInfo.NICInfo == nil {
+		return
+	}
+
+	for _, iface := range machineInfo.NICInfo.PrivateIPInterfaces {
+		if iface.IP == "" {
+			continue
+		}
+		if iface.Addr.IsPrivate() && iface.Addr.Is4() {
+			providerInfo.PrivateIP = iface.IP
+			return
+		}
+	}
+}
