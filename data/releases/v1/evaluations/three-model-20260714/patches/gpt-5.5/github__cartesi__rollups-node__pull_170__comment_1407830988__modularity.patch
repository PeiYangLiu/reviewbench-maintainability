+type genqlientInput struct {
+	Index       int
+	Status      CompletionStatus
+	MsgSender   string
+	Timestamp   string
+	BlockNumber string
+	Payload     string
+}
+
+func inputFromGenqlient(input genqlientInput) (Input, error) {
+	timestamp, err := strconv.ParseUint(input.Timestamp, 0, 64)
+	if err != nil {
+		return Input{}, fmt.Errorf("failed to parse timestamp: %v", err)
+	}
+
+	blocknumber, err := strconv.ParseUint(input.BlockNumber, 0, 64)
+	if err != nil {
+		return Input{}, fmt.Errorf("failed to parse block number: %v", err)
+	}
+	payload, err := hexutil.Decode(input.Payload)
+	if err != nil {
+		return Input{}, fmt.Errorf("failed to decode payload to bytes: %v", err)
+	}
+
+	return Input{
+		Index:       input.Index,
+		Status:      input.Status,
+		MsgSender:   common.HexToAddress(input.MsgSender),
+		Timestamp:   time.Duration(timestamp),
+		BlockNumber: blocknumber,
+		Payload:     payload,
+	}, nil
+}
+
