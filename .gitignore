# ReviewBench-Maintainability: keep intermediate data out of the repository.
# Versioned final releases are tracked; mined snapshots, annotations, and
# temporary exports remain build artifacts.

# --- Project data / artifacts ---
data/*
!data/releases/
data/releases/*
!data/releases/v1/
!data/releases/v1/**
!data/releases/reserves/
data/releases/reserves/*
!data/releases/reserves/20260721/
!data/releases/reserves/20260721/**
!data/releases/reserves/20260728/
!data/releases/reserves/20260728/**
!data/releases/hard/
data/releases/hard/*
!data/releases/hard/README.md
!data/releases/hard/20260808/
!data/releases/hard/20260808/**
# Versioned, reviewable legacy replay contracts (small JSON, no artifacts).
!data/legacy_contracts/
!data/legacy_contracts/**
export/
annotation_results_*/
*.tar.gz
*.pid

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg
pip-wheel-metadata/

# --- Test / type / lint caches ---
.pytest_cache/
.benchmarks/
.amltconfig
.amlt-results/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
sft-adapters/
