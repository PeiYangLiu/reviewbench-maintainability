# ReviewBench-Maintainability: keep the repository code-only.
# Mined datasets, snapshots, annotation products, and exports are large
# build artifacts and are intentionally NOT tracked here.

# --- Project data / artifacts (code-only policy) ---
data/
export/
annotation_results_*/
*.tar.gz
*.pid

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg
pip-wheel-metadata/

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
