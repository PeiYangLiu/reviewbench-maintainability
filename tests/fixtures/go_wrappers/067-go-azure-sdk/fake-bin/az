#!/usr/bin/env bash
set -euo pipefail

case "${1:-} ${2:-}" in
  "version "*)
    echo '{"azure-cli":"2.40.0","azure-cli-core":"2.40.0"}'
    ;;
  "account show")
    echo '{"id":"session-subscription","tenantId":"session-tenant"}'
    ;;
  "account get-access-token")
    echo '{"accessToken":"session-access-token","expiresOn":"2030-01-02 03:04:05.000000","tenant":"session-tenant","tokenType":"Bearer"}'
    ;;
  *)
    echo "unsupported fake az invocation: $*" >&2
    exit 2
    ;;
esac
