{
  "behavior_assertions": [
    "Public max-age and max-version garbage-collection policies retain their documented strings.",
    "Public union and intersection policies retain child ordering and formatting."
  ],
  "command": [
    "bash",
    "{task_dir}/run_oracle.sh",
    "{coverage_out}"
  ],
  "coverage": {
    "kind": "go_coverprofile"
  },
  "cwd": "{repo}/bigtable",
  "environment": {
    "GOTMPDIR": "{root}/go-tmp",
    "GOTOOLCHAIN": "local"
  },
  "environment_description": {
    "dependencies": "Public Go modules use the repository-pinned module graph.",
    "toolchain": "System Go 1.22.2"
  },
  "golden_paths": [
    "bigtable/admin.go",
    "bigtable/bigtable.go",
    "bigtable/gc.go"
  ],
  "inject_files": [
    {
      "destination": "bigtable/sessionoracle/session_oracle_test.go",
      "source": "session_oracle_test.go"
    }
  ],
  "pass_to_pass_tests": [
    "public garbage-collection policy formatting behavior"
  ],
  "timeout": 1200
}
