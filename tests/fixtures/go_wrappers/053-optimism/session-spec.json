{
  "behavior_assertions": [
    "The public withdrawals CLI initializes successfully.",
    "Requesting command help completes without RPC access or an error."
  ],
  "command": [
    "bash",
    "-lc",
    "cd op-chain-ops && go test -v -run '^TestSessionWithdrawalsHelpLifecycle$' -count=1 -coverpkg=github.com/ethereum-optimism/optimism/op-chain-ops/cmd/withdrawals -coverprofile='{coverage_out}' ./cmd/withdrawals"
  ],
  "coverage": {
    "kind": "go_coverprofile"
  },
  "environment": {
    "GOTMPDIR": "{root}/go-tmp",
    "GOTOOLCHAIN": "local",
    "HOME": "{task_dir}/home",
    "TMPDIR": "{root}/go-tmp"
  },
  "environment_description": {
    "dependencies": "The repository-pinned op-chain-ops Go module graph is used.",
    "toolchain": "System Go 1.22.2"
  },
  "golden_paths": [
    "op-chain-ops/go.mod",
    "op-chain-ops/go.sum",
    "op-chain-ops/cmd/withdrawals/main.go",
    "op-chain-ops/crossdomain/legacy_withdrawal.go",
    "op-chain-ops/crossdomain/message.go",
    "op-bindings/bindings/l1crossdomainmessenger.go"
  ],
  "inject_files": [
    {
      "destination": "op-chain-ops/cmd/withdrawals/session_oracle_test.go",
      "source": "session_oracle_test.go"
    },
    {
      "destination": "op-chain-ops/genesis/session_compat.go",
      "source": "genesis_compat.go"
    }
  ],
  "pass_to_pass_tests": [
    "public withdrawals help lifecycle"
  ],
  "timeout": 1800
}
