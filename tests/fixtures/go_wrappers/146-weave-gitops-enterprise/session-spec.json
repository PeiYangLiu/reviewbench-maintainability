{
  "behavior_assertions": [
    "The public bootstrap command constructor returns a command named bootstrap.",
    "Executing the public help path succeeds and renders bootstrap usage."
  ],
  "command": [
    "bash",
    "{task_dir}/run_oracle.sh",
    "{coverage_out}",
    "{task_dir}/dependency-stubs/enterprise-credentials"
  ],
  "coverage": {
    "kind": "go_coverprofile"
  },
  "environment": {
    "GOTMPDIR": "{root}/go-tmp",
    "GOTOOLCHAIN": "local",
    "TMPDIR": "{root}/go-tmp"
  },
  "environment_description": {
    "dependencies": "Public Go modules use the repository-pinned graph; the unavailable entitlement verifier is a deterministic compile-time API-compatible boundary and is not invoked by help.",
    "toolchain": "System Go 1.22.2"
  },
  "golden_paths": [
    "cmd/gitops/app/bootstrap/cmd.go",
    "go.mod",
    "go.sum",
    "pkg/bootstrap/bootstrap.go",
    "pkg/bootstrap/steps/admin_password.go",
    "pkg/bootstrap/steps/config.go",
    "pkg/bootstrap/steps/domain_type.go",
    "pkg/bootstrap/steps/entitlement.go",
    "pkg/bootstrap/steps/flux.go",
    "pkg/bootstrap/steps/install_wge.go",
    "pkg/bootstrap/steps/private_key.go",
    "pkg/bootstrap/steps/public.pem",
    "pkg/bootstrap/steps/step.go",
    "pkg/bootstrap/steps/success_page.go",
    "pkg/bootstrap/steps/wge_version.go",
    "pkg/bootstrap/utils/flux.go",
    "pkg/bootstrap/utils/git.go",
    "pkg/bootstrap/utils/input.go",
    "pkg/bootstrap/utils/k8s.go"
  ],
  "inject_files": [
    {
      "destination": "cmd/gitops/app/bootstrap/sessionoracle/session_oracle_test.go",
      "source": "session_oracle_test.go"
    }
  ],
  "pass_to_pass_tests": [
    "public bootstrap command help behavior"
  ],
  "timeout": 1200
}
