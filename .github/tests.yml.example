name: Tests

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
      - run: python -m pip install -e ".[dev,agentic]"
      - name: Core Python 3.10 compatibility
        if: matrix.python-version == '3.10'
        run: >-
          python -m pytest -q tests/test_build_dataset.py tests/test_curate_pool.py
          tests/test_evaluate.py tests/test_evidence.py tests/test_heuristics.py
          tests/test_merge_candidates.py tests/test_quality_gate.py tests/test_recovery.py
          tests/test_release.py tests/test_static_metrics.py tests/test_jsonl.py
          tests/test_agentic_exec.py tests/test_external_artifacts.py
      - name: Full retained suite (Python 3.12 runtime helpers)
        if: matrix.python-version == '3.12'
        run: python -m pytest -q
      - run: python -m build
